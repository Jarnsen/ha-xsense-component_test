{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "timezone": "America/St_Johns",
  "schedule": [
    "before 6am on monday"
  ],
  "labels": [
    "dependency-update"
  ],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 1,
  "rangeStrategy": "bump",
  "enabledManagers": [
    "github-actions",
    "gomod",
    "pip_requirements"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "groupName": "Go dependencies"
    },
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "groupName": "Python test dependencies"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    }
  ]
}
