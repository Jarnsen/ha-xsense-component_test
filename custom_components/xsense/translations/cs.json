  "options": {
    "step": {
      "init": {
        "description": "Synchronizace záznamových médií ukládá do mezipaměti klipy z fotoaparátu pod média Home Assistant, takže postranní panel Nahrávek X-Sense, Prohlížeč médií a mobilní oznámení mohou rychle otevřít nahrávky. Ponechte jej pro ukládání do mezipaměti pouze tehdy, když jsou otevřeny. Aktivujte ji, aby byly poslední nahrávky připraveny na pozadí.",
        "data": {
          "recording_media_sync_enabled": "Synchronizace nahrávacího média",
          "recording_media_sync_hours": "Interval synchronizace na pozadí",
          "recording_media_storage_path": "Složka mezipaměti záznamů",
          "recording_notification_quality": "Kvalita záznamu oznámení",
          "recording_media_days_order": "Objednávka dne záznamu",
          "recording_media_clips_order": "Pořadí nahrávání klipů"
        },
        "data_description": {
          "recording_media_sync_enabled": "Automaticky ukládat poslední nahrávky do mezipaměti. To využívá úložný prostor a může častěji probudit kamery.",
          "recording_media_sync_hours": "Jak často by měla běžet normální synchronizace na pozadí. Pokud je povolena synchronizace, poslední nahrávky se kontrolují každých pár minut.",
          "recording_media_storage_path": "Použijte složku pod /media. Zde se ukládají nová videa a miniatury uložené v mezipaměti.",
          "recording_notification_quality": "Vyberte HD, chcete-li upřednostnit přímé adresy URL klipů/ve vysokém rozlišení X-Sense pro mobilní oznámení. Zvolte SD, chcete-li použít cestu snímání přehrávání kamery, je-li k dispozici.",
          "recording_media_days_order": "Zvolte, zda se v prohlížeči nahrávek jako první zobrazí novější nebo starší dny.",
          "recording_media_clips_order": "Vyberte, zda se v každém dni zobrazí jako první novější nebo starší klipy."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "Složka mezipaměti záznamů se změní z `{old_path}` na `{new_path}`. Stávající videa a miniatury uložené v mezipaměti se nepřesouvají automaticky. Pokud chcete, aby staré nahrávky uložené v mezipaměti zůstaly dostupné, přesuňte nejprve existující složky `videos` a `thumbs`."
      }
    },
