  "options": {
    "step": {
      "init": {
        "description": "Výchozí je pouze přehrávání, které při přehrávání předává nahrávky přes Home Assistant bez uchovávání celých klipů. Chcete-li ukládat klipy do médií Home Assistant podle nastaveného stáří a velikosti, zvolte uchovávání místních nahrávek. Synchronizace na pozadí běží jen v režimu uchovávání.",
        "data": {
          "recording_media_sync_enabled": "Synchronizace nahrávacího média",
          "recording_media_sync_hours": "Interval synchronizace na pozadí",
          "recording_media_storage_path": "Složka mezipaměti záznamů",
          "recording_notification_quality": "Kvalita záznamu oznámení",
          "recording_media_days_order": "Objednávka dne záznamu",
          "recording_media_clips_order": "Pořadí nahrávání klipů",
          "recording_cache_retention_days": "Uchovávání mezipaměti záznamu",
          "recording_cache_max_size_mb": "Maximální velikost mezipaměti pro nahrávání",
          "recording_cache_mode": "Režim ukládání nahrávek"
        },
        "data_description": {
          "recording_media_sync_enabled": "Automaticky ukládat poslední nahrávky do mezipaměti. To využívá úložný prostor a může častěji probudit kamery.",
          "recording_media_sync_hours": "Jak často by měla běžet normální synchronizace na pozadí. Pokud je povolena synchronizace, poslední nahrávky se kontrolují každých pár minut.",
          "recording_media_storage_path": "Použijte složku pod /media. Zde se ukládají nová videa a miniatury uložené v mezipaměti.",
          "recording_notification_quality": "HD upřednostňuje adresy záznamů s vyšším rozlišením. SD upřednostňuje standardní rozlišení, pokud je X-Sense poskytuje.",
          "recording_media_days_order": "Zvolte, zda se v prohlížeči nahrávek jako první zobrazí novější nebo starší dny.",
          "recording_media_clips_order": "Vyberte, zda se v každém dni zobrazí jako první novější nebo starší klipy.",
          "recording_cache_retention_days": "Po tomto mnoha dnech smažte místní nahrávky uložené v mezipaměti. Cloud X-Sense a záznamy na SD kartě se nezmění.",
          "recording_cache_max_size_mb": "Maximální velikost místní mezipaměti v MB. Po dosažení limitu jsou nejdříve odstraněny nahrávky, které byly naposledy zobrazeny.",
          "recording_cache_mode": "Pouze přehrávání předává média HLS na vyžádání přes Home Assistant bez uchovávání celých klipů. Režim uchovávání ukládá místní kopie podle níže uvedených limitů."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "Složka mezipaměti záznamů se změní z `{old_path}` na `{new_path}`. Stávající videa a miniatury uložené v mezipaměti se nepřesouvají automaticky. Pokud chcete, aby staré nahrávky uložené v mezipaměti zůstaly dostupné, přesuňte nejprve existující složky `hls`, `videos` a `thumbs`."
      }
    },
