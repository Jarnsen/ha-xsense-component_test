  "options": {
    "step": {
      "init": {
        "description": "ৰেকৰ্ডিং মিডিয়া ছিঙ্কে Home Assistant মাধ্যমৰ অন্তৰ্গত কেমেৰা ক্লিপসমূহ কেশ্ব কৰে যাতে X-Sense ৰেকৰ্ডিংসমূহ চাইডবাৰ, মিডিয়া ব্ৰাউজাৰ, আৰু মোবাইল জাননীসমূহে ৰেকৰ্ডিংসমূহ দ্ৰুতভাৱে খোলিব পাৰে। ৰেকৰ্ডিংসমূহ খোলাৰ পিছতহে ইয়াক কেশ্ব কৰিবলৈ বন্ধ কৰক। ইয়াক পটভূমিত শেহতীয়া ৰেকৰ্ডিংসমূহ সাজু কৰি ৰাখিবলৈ সামৰ্থবান কৰক।",
        "data": {
          "recording_media_sync_enabled": "ৰেকৰ্ডিং মিডিয়া ছিংক",
          "recording_media_sync_hours": "পটভূমি ছিঙ্ক ব্যৱধান",
          "recording_media_storage_path": "ৰেকৰ্ডিং কেচ ফোল্ডাৰ",
          "recording_notification_quality": "অধিসূচনা ৰেকৰ্ডিং মান",
          "recording_media_days_order": "ৰেকৰ্ডিং ডে অৰ্ডাৰ",
          "recording_media_clips_order": "ক্লিপ অৰ্ডাৰ ৰেকৰ্ডিং"
        },
        "data_description": {
          "recording_media_sync_enabled": "শেহতীয়া ৰেকৰ্ডিংসমূহ স্বয়ংক্ৰিয়ভাৱে কেশ্ব কৰক। ইয়াৰ দ্বাৰা সংৰক্ষণ স্থান ব্যৱহাৰ কৰা হয় আৰু কেমেৰাক অধিক সঘনাই জগাই তুলিব পাৰে।",
          "recording_media_sync_hours": "সাধাৰণ পটভূমি কেচ-আপ ছিংক কিমান সঘনাই চলিব লাগে। শেহতীয়া ৰেকৰ্ডিংসমূহ প্ৰতি দুমিনিটৰ মূৰে মূৰে পৰীক্ষা কৰা হয় যেতিয়া ছিঙ্ক সামৰ্থবান কৰা হয়।",
          "recording_media_storage_path": "/media ৰ অন্তৰ্গত এটা ফোল্ডাৰ ব্যৱহাৰ কৰক। নতুন কেচ কৰা ভিডিঅ' আৰু থাম্বনেইলসমূহ ইয়াত সংৰক্ষণ কৰা হয়।",
          "recording_notification_quality": "মোবাইল জাননীসমূহৰ বাবে X-Sense ৰ প্ৰত্যক্ষ/উচ্চ-ৰিজ'লিউচন ক্লিপ URLসমূহ পছন্দ কৰিবলে HD নিৰ্ব্বাচন কৰক। উপলব্ধ হ'লে কেমেৰা প্লেবেক কেপচাৰ পথ ব্যৱহাৰ কৰিবলে SD নিৰ্ব্বাচন কৰক।",
          "recording_media_days_order": "ৰেকৰ্ডিং দৰ্শকত নতুন বা পুৰণি দিন প্ৰথমে দেখা দিয়ে নে নাই বাছক।",
          "recording_media_clips_order": "প্ৰতিটো দিনৰ ভিতৰত নতুন বা পুৰণি ক্লিপসমূহ প্ৰথমে দেখা দিয়ে নেকি বাছক।"
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "ৰেকৰ্ডিং কেশ্ব ফোল্ডাৰ `{old_path}` ৰ পৰা `{new_path}` লৈ সলনি হ'ব। বৰ্তমানৰ কেচ কৰা ভিডিঅ' আৰু থাম্বনেইলসমূহ স্বয়ংক্ৰিয়ভাৱে স্থানান্তৰ কৰা নহয়। বৰ্ত্তমানৰ `videos` আৰু `thumbs` ফোল্ডাৰসমূহ প্ৰথমে স্থানান্তৰ কৰক যদি আপুনি পুৰণি কেশ্ব কৰা ৰেকৰ্ডিংসমূহ উপলব্ধ থাকিব বিচাৰে।"
      }
