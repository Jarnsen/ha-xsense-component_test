  "options": {
    "step": {
      "init": {
        "description": "La sincronización de medios de grabación almacena en caché los clips de la cámara en los medios Home Assistant para que la barra lateral de grabaciones X-Sense, el navegador de medios y las notificaciones móviles puedan abrir las grabaciones rápidamente. Déjelo desactivado para almacenar en caché las grabaciones sólo cuando estén abiertas. Habilítelo para mantener las grabaciones recientes listas en segundo plano.",
        "data": {
          "recording_media_sync_enabled": "Sincronización de medios de grabación",
          "recording_media_sync_hours": "Intervalo de sincronización en segundo plano",
          "recording_media_storage_path": "Carpeta de caché de grabación",
          "recording_notification_quality": "Calidad de grabación de notificaciones",
          "recording_media_days_order": "Orden del día de grabación",
          "recording_media_clips_order": "Orden de clips de grabación"
        },
        "data_description": {
          "recording_media_sync_enabled": "Almacene en caché las grabaciones recientes automáticamente. Esto utiliza espacio de almacenamiento y puede activar las cámaras con más frecuencia.",
          "recording_media_sync_hours": "Con qué frecuencia debe ejecutarse la sincronización normal de actualización en segundo plano. Las grabaciones recientes se verifican cada dos minutos cuando la sincronización está habilitada.",
          "recording_media_storage_path": "Utilice una carpeta en /media. Aquí se almacenan nuevos vídeos y miniaturas almacenados en caché.",
          "recording_notification_quality": "Elija HD para preferir las URL de clip directo/de alta resolución de X-Sense para notificaciones móviles. Elija SD para usar la ruta de captura de reproducción de la cámara cuando esté disponible.",
          "recording_media_days_order": "Elija si los días más nuevos o más antiguos aparecen primero en el visor de grabaciones.",
          "recording_media_clips_order": "Elija si los clips más nuevos o más antiguos aparecen primero cada día."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "La carpeta de caché de grabación cambiará de `{old_path}`a `{new_path}`. Los vídeos y miniaturas almacenados en caché existentes no se mueven automáticamente. Mueva primero las carpetas `videos`y `thumbs`existentes si desea que las grabaciones antiguas en caché sigan estando disponibles."
      }
    },
    "error": {
      "invalid_recording_media_path": "Utilice una carpeta en /media."
    },
    "abort": {
      "no_options": "No hay opciones configurables para esta cuenta X-Sense."
