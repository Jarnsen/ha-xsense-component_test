    "step": {
      "init": {
        "description": "Domyślny tryb tylko odtwarzanie przekazuje nagrania przez Home Assistant podczas odtwarzania bez zachowywania pełnych klipów. Wybierz zachowywanie nagrań lokalnych, aby przechowywać klipy w multimediach Home Assistant zgodnie z ustawionymi limitami wieku i rozmiaru. Synchronizacja w tle działa tylko w trybie zachowywania.",
        "data": {
          "recording_media_sync_enabled": "Synchronizacja nośników nagrań",
          "recording_media_sync_hours": "Interwał synchronizacji w tle",
          "recording_media_storage_path": "Folder pamięci podręcznej nagrań",
          "recording_notification_quality": "Jakość nagrywania powiadomień",
          "recording_media_days_order": "Kolejność dnia nagrania",
          "recording_media_clips_order": "Kolejność nagrywania klipów",
          "recording_cache_retention_days": "Zachowywanie pamięci podręcznej nagrań",
          "recording_cache_max_size_mb": "Maksymalny rozmiar pamięci podręcznej nagrań",
          "recording_cache_mode": "Tryb przechowywania nagrań"
        },
        "data_description": {
          "recording_media_sync_enabled": "Automatycznie buforuj ostatnie nagrania. Zajmuje to miejsce w pamięci i może częściej budzić kamery.",
          "recording_media_sync_hours": "Jak często powinna uruchamiać się normalna synchronizacja w tle. Gdy włączona jest synchronizacja, najnowsze nagrania są sprawdzane co kilka minut.",
          "recording_media_storage_path": "Użyj folderu w obszarze /media. Tutaj przechowywane są nowe filmy i miniatury zapisane w pamięci podręcznej.",
          "recording_notification_quality": "HD preferuje adresy URL nagrań o wyższej rozdzielczości. SD preferuje standardową rozdzielczość, gdy X-Sense ją udostępnia.",
          "recording_media_days_order": "Wybierz, czy w przeglądarce nagrań mają się najpierw pojawiać nowsze, czy starsze dni.",
          "recording_media_clips_order": "Wybierz, czy każdego dnia jako pierwsze mają pojawiać się nowsze czy starsze klipy.",
          "recording_cache_retention_days": "Usuń nagrania z lokalnej pamięci podręcznej po tylu dniach. Nagrania w chmurze X-Sense i na karcie SD nie ulegają zmianie.",
          "recording_cache_max_size_mb": "Maksymalny rozmiar lokalnej pamięci podręcznej w MB. Po osiągnięciu limitu w pierwszej kolejności usuwane są nagrania ostatnio oglądane.",
          "recording_cache_mode": "Tryb tylko odtwarzanie przekazuje multimedia HLS przez Home Assistant na żądanie bez zachowywania pełnych klipów. Tryb zachowywania przechowuje lokalne kopie zgodnie z poniższymi limitami."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "Folder pamięci podręcznej nagrań zmieni się z `{old_path}` na `{new_path}`. Istniejące filmy i miniatury zapisane w pamięci podręcznej nie są przenoszone automatycznie. Jeśli chcesz, aby stare nagrania w pamięci podręcznej pozostały dostępne, przenieś najpierw istniejące foldery `hls`, `videos` i `thumbs`."
      }
    },
