  "options": {
    "step": {
      "init": {
        "description": "录制媒体同步会在 Home Assistant 媒体下缓存摄像机剪辑，以便 X-Sense 录制侧边栏、媒体浏览器和移动通知可以快速打开录制。仅当录音打开时才将其关闭以缓存录音。使其能够在后台保留最近的录音。",
        "data": {
          "recording_media_sync_enabled": "录制媒体同步",
          "recording_media_sync_hours": "后台同步间隔",
          "recording_media_storage_path": "录音缓存文件夹",
          "recording_notification_quality": "通知录制质量",
          "recording_media_days_order": "录音日顺序",
          "recording_media_clips_order": "录制剪辑顺序"
        },
        "data_description": {
          "recording_media_sync_enabled": "自动缓存最近的录制内容。这会占用存储空间，并且可能会更频繁地唤醒摄像头。",
          "recording_media_sync_hours": "正常后台追赶同步应运行的频率。启用同步后，每隔几分钟就会检查一次最近的录音。",
          "recording_media_storage_path": "使用 /media 下的文件夹。新的缓存视频和缩略图会存储在这里。",
          "recording_notification_quality": "选择 HD 以首选 X-Sense 的移动通知的直接/高分辨率剪辑 URL。选择 SD 以使用相机回放捕获路径（如果可用）。",
          "recording_media_days_order": "选择较新的日期还是较旧的日期首先显示在录音查看器中。",
          "recording_media_clips_order": "选择每天首先显示较新的剪辑还是较旧的剪辑。"
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "录制缓存文件夹将从 `{old_path}` 更改为 `{new_path}`。现有的缓存视频和缩略图不会自动移动。如果您希望旧的缓存录制内容保持可用，请先移动现有的 `videos` 和 `thumbs` 文件夹。"
      }
    },
