  "options": {
    "step": {
      "init": {
        "description": "Синхронізація медіафайлів запису кешує відеокліпи камери під носіями Home Assistant, щоб на бічній панелі записів X-Sense, медіа-браузері та мобільних сповіщеннях можна було швидко відкривати записи. Залиште його вимкненим, щоб кешувати записи лише тоді, коли вони відкриті. Увімкніть його, щоб останні записи залишалися готовими у фоновому режимі.",
        "data": {
          "recording_media_sync_enabled": "Синхронізація носіїв запису",
          "recording_media_sync_hours": "Інтервал фонової синхронізації",
          "recording_media_storage_path": "Папка кеша запису",
          "recording_notification_quality": "Якість запису сповіщень",
          "recording_media_days_order": "Порядок дня запису",
          "recording_media_clips_order": "Порядок запису кліпу"
        },
        "data_description": {
          "recording_media_sync_enabled": "Кешувати останні записи автоматично. Це займає простір у пам’яті та може частіше виводити камери з режиму сну.",
          "recording_media_sync_hours": "Як часто має виконуватися звичайна фонова наздоганяюча синхронізація. Останні записи перевіряються кожні кілька хвилин, коли ввімкнено синхронізацію.",
          "recording_media_storage_path": "Використовуйте папку під /media. Тут зберігаються нові кешовані відео та мініатюри.",
          "recording_notification_quality": "Виберіть HD, щоб віддати перевагу прямим/високороздільним URL-адресам кліпу X-Sense для мобільних сповіщень. Виберіть SD, щоб використовувати шлях захоплення відтворення камери, якщо він доступний.",
          "recording_media_days_order": "Виберіть, чи з’являтимуться новіші чи старіші дні в засобі перегляду записів.",
          "recording_media_clips_order": "Виберіть, чи з’являтимуться нові або старі кліпи першими протягом кожного дня."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "Папка кешу записів зміниться з `{old_path}` на `{new_path}`. Існуючі кешовані відео та мініатюри не переміщуються автоматично. Спочатку перемістіть існуючі папки `videos` і `thumbs`, якщо ви хочете, щоб старі кешовані записи залишалися доступними."
      }
    },
    "error": {
      "invalid_recording_media_path": "Використовуйте папку під /media."
    },
    "abort": {
      "no_options": "Для цього облікового запису X-Sense немає параметрів, які можна налаштувати."
    }
  },
