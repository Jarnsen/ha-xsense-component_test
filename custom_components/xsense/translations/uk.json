  "options": {
    "step": {
      "init": {
        "description": "Типовий режим лише відтворення передає записи через Home Assistant під час перегляду без збереження повних кліпів. Виберіть збереження локальних записів, щоб тримати кліпи в медіа Home Assistant за налаштованими обмеженнями віку та розміру. Фонова синхронізація працює лише в режимі збереження.",
        "data": {
          "recording_media_sync_enabled": "Синхронізація носіїв запису",
          "recording_media_sync_hours": "Інтервал фонової синхронізації",
          "recording_media_storage_path": "Папка кеша запису",
          "recording_notification_quality": "Якість запису сповіщень",
          "recording_media_days_order": "Порядок дня запису",
          "recording_media_clips_order": "Порядок запису кліпу",
          "recording_cache_retention_days": "Зберігання кешу запису",
          "recording_cache_max_size_mb": "Максимальний розмір кешу запису",
          "recording_cache_mode": "Режим зберігання записів"
        },
        "data_description": {
          "recording_media_sync_enabled": "Кешувати останні записи автоматично. Це займає простір у пам’яті та може частіше виводити камери з режиму сну.",
          "recording_media_sync_hours": "Як часто має виконуватися звичайна фонова наздоганяюча синхронізація. Останні записи перевіряються кожні кілька хвилин, коли ввімкнено синхронізацію.",
          "recording_media_storage_path": "Використовуйте папку під /media. Тут зберігаються нові кешовані відео та мініатюри.",
          "recording_notification_quality": "HD надає перевагу URL записів із вищою роздільною здатністю. SD надає перевагу стандартній роздільній здатності, якщо X-Sense її надає.",
          "recording_media_days_order": "Виберіть, чи з’являтимуться новіші чи старіші дні в засобі перегляду записів.",
          "recording_media_clips_order": "Виберіть, чи з’являтимуться нові або старі кліпи першими протягом кожного дня.",
          "recording_cache_retention_days": "Видаліть локальні кешовані записи через стільки днів. Записи хмари X-Sense і SD-карти не змінюються.",
          "recording_cache_max_size_mb": "Максимальний розмір локального кешу в МБ. Коли ліміт буде досягнуто, спочатку видаляються записи, які нещодавно переглядалися.",
          "recording_cache_mode": "Режим лише відтворення передає HLS-медіа через Home Assistant на вимогу без збереження повних кліпів. Режим збереження тримає локальні копії за наведеними нижче обмеженнями."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "Папка кешу записів зміниться з `{old_path}` на `{new_path}`. Існуючі кешовані відео та мініатюри не переміщуються автоматично. Спочатку перемістіть існуючі папки `hls`, `videos` і `thumbs`, якщо ви хочете, щоб старі кешовані записи залишалися доступними."
      }
    },
    "error": {
      "invalid_recording_media_path": "Використовуйте папку під /media."
