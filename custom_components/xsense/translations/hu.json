  "options": {
    "step": {
      "init": {
        "description": "Az alapértelmezett csak lejátszás mód lejátszás közben a Home Assistanton keresztül továbbítja a felvételeket, teljes klipek megőrzése nélkül. A klipek Home Assistant médiában, a beállított kor- és méretkorlátok szerint történő tárolásához válassza a helyi felvételek megőrzését. A háttérszinkronizálás csak megőrzési módban fut.",
        "data": {
          "recording_media_sync_enabled": "Felvételi adathordozó szinkronizálása",
          "recording_media_sync_hours": "Háttér szinkronizálási időköz",
          "recording_media_storage_path": "Rögzítési gyorsítótár mappa",
          "recording_notification_quality": "Értesítés rögzítési minősége",
          "recording_media_days_order": "Felvételi napi rendelés",
          "recording_media_clips_order": "Klip rendelés rögzítése",
          "recording_cache_retention_days": "Rögzítés gyorsítótár megőrzése",
          "recording_cache_max_size_mb": "Maximális rögzítési gyorsítótár mérete",
          "recording_cache_mode": "Felvételek tárolási módja"
        },
        "data_description": {
          "recording_media_sync_enabled": "A legutóbbi felvételek automatikus gyorsítótárazása. Ez tárhelyet foglal el, és gyakrabban ébresztheti fel a kamerákat.",
          "recording_media_sync_hours": "Milyen gyakran fut a normál háttér-felzárkózási szinkronizálás. A legutóbbi felvételeket a rendszer néhány percenként ellenőrzi, ha a szinkronizálás engedélyezve van.",
          "recording_media_storage_path": "Használjon egy mappát a /media alatt. Az új gyorsítótárazott videók és miniatűrök itt tárolódnak.",
          "recording_notification_quality": "A HD a nagyobb felbontású felvételi URL-eket részesíti előnyben. Az SD a normál felbontást részesíti előnyben, ha az X-Sense biztosítja.",
          "recording_media_days_order": "Válassza ki, hogy az újabb vagy a régebbi napok jelenjenek meg először a felvételnézőben.",
          "recording_media_clips_order": "Válassza ki, hogy az újabb vagy a régebbi klipek jelenjenek meg először minden napon.",
          "recording_cache_retention_days": "Törölje a helyi gyorsítótárazott felvételeket ennyi nap elteltével. Az X-Sense felhő és az SD-kártya felvételei nem változnak.",
          "recording_cache_max_size_mb": "A helyi gyorsítótár maximális mérete MB-ban. A korlát elérésekor először a legutóbb megtekintett felvételek törlődnek.",
          "recording_cache_mode": "A csak lejátszás mód igény szerint továbbítja a HLS-médiát a Home Assistanton keresztül, teljes klipek megőrzése nélkül. A megőrzési mód helyi másolatokat tart az alábbi korlátok szerint."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "A rögzítési gyorsítótár mappa `{old_path}`-ről `{new_path}`-re változik. A meglévő gyorsítótárazott videók és miniatűrök nem kerülnek át automatikusan. Először helyezze át a meglévő `hls`, `videos` és `thumbs` mappákat, ha azt szeretné, hogy a régi gyorsítótárazott felvételek elérhetők maradjanak."
      }
    },
