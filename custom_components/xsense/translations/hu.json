  "options": {
    "step": {
      "init": {
        "description": "A felvételi médiaszinkronizálás gyorsítótárazza a kamera klipjeit a Home Assistant adathordozó alatt, így az X-Sense Recordings oldalsáv, a médiaböngésző és a mobil értesítések gyorsan megnyithatják a felvételeket. Hagyja kikapcsolva a felvételek gyorsítótárazását, ha megnyitják őket. Engedélyezze a legutóbbi felvételek háttérben tartásához.",
        "data": {
          "recording_media_sync_enabled": "Felvételi adathordozó szinkronizálása",
          "recording_media_sync_hours": "Háttér szinkronizálási időköz",
          "recording_media_storage_path": "Rögzítési gyorsítótár mappa",
          "recording_notification_quality": "Értesítés rögzítési minősége",
          "recording_media_days_order": "Felvételi napi rendelés",
          "recording_media_clips_order": "Klip rendelés rögzítése"
        },
        "data_description": {
          "recording_media_sync_enabled": "A legutóbbi felvételek automatikus gyorsítótárazása. Ez tárhelyet foglal el, és gyakrabban ébresztheti fel a kamerákat.",
          "recording_media_sync_hours": "Milyen gyakran fut a normál háttér-felzárkózási szinkronizálás. A legutóbbi felvételeket a rendszer néhány percenként ellenőrzi, ha a szinkronizálás engedélyezve van.",
          "recording_media_storage_path": "Használjon egy mappát a /media alatt. Az új gyorsítótárazott videók és miniatűrök itt tárolódnak.",
          "recording_notification_quality": "Válassza a HD lehetőséget, ha előnyben szeretné részesíteni az X-Sense közvetlen/nagy felbontású klip URL-jeit a mobil értesítésekhez. Válassza az SD lehetőséget a kamera lejátszási rögzítési útvonalának használatához, ha elérhető.",
          "recording_media_days_order": "Válassza ki, hogy az újabb vagy a régebbi napok jelenjenek meg először a felvételnézőben.",
          "recording_media_clips_order": "Válassza ki, hogy az újabb vagy a régebbi klipek jelenjenek meg először minden napon."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "A rögzítési gyorsítótár mappa `{old_path}`-ről `{new_path}`-re változik. A meglévő gyorsítótárazott videók és miniatűrök nem kerülnek át automatikusan. Először helyezze át a meglévő `videos` és `thumbs` mappákat, ha azt szeretné, hogy a régi gyorsítótárazott felvételek elérhetők maradjanak."
      }
    },
    "error": {
      "invalid_recording_media_path": "Használjon egy mappát a /media alatt."
    },
    "abort": {
      "no_options": "Ehhez az X-Sense-fiókhoz nincsenek konfigurálható beállítások."
