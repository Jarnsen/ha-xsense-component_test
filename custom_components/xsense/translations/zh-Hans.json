  "options": {
    "step": {
      "init": {
        "description": "默认使用仅播放模式，播放时通过 Home Assistant 代理录像，不保留完整片段。选择保留本地录像，可按配置的保存期限和大小限制将片段存入 Home Assistant 媒体目录。后台同步仅在保留模式下运行。",
        "data": {
          "recording_media_sync_enabled": "录制媒体同步",
          "recording_media_sync_hours": "后台同步间隔",
          "recording_media_storage_path": "录音缓存文件夹",
          "recording_notification_quality": "通知录制质量",
          "recording_media_days_order": "录音日顺序",
          "recording_media_clips_order": "录制剪辑顺序",
          "recording_cache_retention_days": "录音缓存保留",
          "recording_cache_max_size_mb": "最大录音缓存大小",
          "recording_cache_mode": "录像存储模式"
        },
        "data_description": {
          "recording_media_sync_enabled": "自动缓存最近的录制内容。这会占用存储空间，并且可能会更频繁地唤醒摄像头。",
          "recording_media_sync_hours": "正常后台追赶同步应运行的频率。启用同步后，每隔几分钟就会检查一次最近的录音。",
          "recording_media_storage_path": "使用 /media 下的文件夹。新的缓存视频和缩略图会存储在这里。",
          "recording_notification_quality": "HD 优先使用较高分辨率的录像 URL。SD 优先使用 X-Sense 提供的标准分辨率 URL（如有）。",
          "recording_media_days_order": "选择较新的日期还是较旧的日期首先显示在录音查看器中。",
          "recording_media_clips_order": "选择每天首先显示较新的剪辑还是较旧的剪辑。",
          "recording_cache_retention_days": "在这么多天后删除本地缓存的录音。 X-Sense云和SD卡录音没有改变。",
          "recording_cache_max_size_mb": "最大本地缓存大小（以 MB 为单位）。当达到限制时，最近最少查看的录音将首先被删除。",
          "recording_cache_mode": "仅播放模式按需通过 Home Assistant 代理 HLS 媒体，不保留完整片段。保留模式按下方限制保存本地副本。"
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "录制缓存文件夹将从 `{old_path}` 更改为 `{new_path}`。现有的缓存视频和缩略图不会自动移动。如果您希望旧的缓存录制内容保持可用，请先移动现有的 `hls`, `videos` 和 `thumbs` 文件夹。"
      }
    },
    "error": {
      "invalid_recording_media_path": "请使用 /media 下的文件夹。"
    },
    "abort": {
      "no_options": "此 X-Sense 帐户没有可配置选项。"
    }
