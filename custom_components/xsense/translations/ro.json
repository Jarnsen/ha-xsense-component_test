          "recording_media_sync_enabled": "Sincronizare media de înregistrare",
          "recording_media_sync_hours": "Interval de sincronizare în fundal",
          "recording_media_storage_path": "Dosarul cache de înregistrare",
          "recording_notification_quality": "Calitatea înregistrării notificărilor",
          "recording_media_days_order": "Comanda zilei de înregistrare",
          "recording_media_clips_order": "Ordinea clipurilor de înregistrare",
          "recording_cache_retention_days": "Reținerea memoriei cache a înregistrărilor",
          "recording_cache_max_size_mb": "Dimensiunea maximă a memoriei cache de înregistrare",
          "recording_cache_mode": "Mod de stocare a înregistrărilor"
        },
        "data_description": {
          "recording_media_sync_enabled": "Memorați în cache înregistrările recente în mod automat. Aceasta utilizează spațiu de stocare și poate trezi camerele mai des.",
          "recording_media_sync_hours": "Cât de des ar trebui să ruleze sincronizarea normală de recuperare în fundal. Înregistrările recente sunt verificate la fiecare două minute când sincronizarea este activată.",
          "recording_media_storage_path": "Utilizați un folder sub /media. Noile videoclipuri și miniaturi stocate în cache sunt stocate aici.",
          "recording_notification_quality": "HD preferă URL-urile înregistrărilor cu rezoluție mai mare. SD preferă rezoluția standard atunci când X-Sense o oferă.",
          "recording_media_days_order": "Alegeți dacă zilele mai noi sau mai vechi apar mai întâi în vizualizatorul de înregistrări.",
          "recording_media_clips_order": "Alegeți dacă clipurile mai noi sau mai vechi apar primele în fiecare zi.",
          "recording_cache_retention_days": "Ștergeți înregistrările locale stocate în cache după atâtea zile. Înregistrările în cloud X-Sense și cardul SD nu sunt modificate.",
          "recording_cache_max_size_mb": "Dimensiunea maximă a memoriei cache locală în MB. Când limita este atinsă, cele mai puțin recent înregistrări vizualizate sunt eliminate mai întâi.",
          "recording_cache_mode": "Doar redare transmite conținutul HLS la cerere prin Home Assistant fără a păstra clipurile complete. Modul de păstrare menține copii locale conform limitelor de mai jos."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "Dosarul cache de înregistrare se va schimba din `{old_path}` în `{new_path}`. Videoclipurile și miniaturile existente în cache nu sunt mutate automat. Mutați mai întâi dosarele existente `hls`, `videos` și `thumbs` dacă doriți ca înregistrările vechi din cache să rămână disponibile."
      }
    },
