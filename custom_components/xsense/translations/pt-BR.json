  "options": {
    "step": {
      "init": {
        "description": "A sincronização de mídia de gravação armazena em cache os clipes da câmera na mídia Home Assistant para que a barra lateral de gravações X-Sense, o navegador de mídia e as notificações móveis possam abrir as gravações rapidamente. Deixe-o desativado para armazenar em cache as gravações somente quando elas forem abertas. Ative-o para manter as gravações recentes prontas em segundo plano.",
        "data": {
          "recording_media_sync_enabled": "Gravação de sincronização de mídia",
          "recording_media_sync_hours": "Intervalo de sincronização em segundo plano",
          "recording_media_storage_path": "Pasta de cache de gravação",
          "recording_notification_quality": "Qualidade de gravação de notificação",
          "recording_media_days_order": "Ordem do dia de gravação",
          "recording_media_clips_order": "Gravando a ordem dos clipes"
        },
        "data_description": {
          "recording_media_sync_enabled": "Armazene em cache as gravações recentes automaticamente. Isso utiliza espaço de armazenamento e pode ativar as câmeras com mais frequência.",
          "recording_media_sync_hours": "Com que frequência a sincronização normal de atualização em segundo plano deve ser executada. As gravações recentes são verificadas a cada dois minutos quando a sincronização está ativada.",
          "recording_media_storage_path": "Use uma pasta em /media. Novos vídeos e miniaturas em cache são armazenados aqui.",
          "recording_notification_quality": "Escolha HD para preferir os URLs de clipe direto/de alta resolução do X-Sense para notificações móveis. Escolha SD para usar o caminho de captura de reprodução da câmera quando disponível.",
          "recording_media_days_order": "Escolha se os dias mais recentes ou mais antigos aparecem primeiro no visualizador de gravações.",
          "recording_media_clips_order": "Escolha se os clipes mais recentes ou mais antigos aparecem primeiro em cada dia."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "A pasta de cache de gravação mudará de `{old_path}` para `{new_path}`. Os vídeos e miniaturas existentes em cache não são movidos automaticamente. Mova primeiro as pastas `videos` e `thumbs` existentes se desejar que as gravações antigas em cache permaneçam disponíveis."
      }
    },
    "error": {
      "invalid_recording_media_path": "Use uma pasta em /media."
    },
    "abort": {
      "no_options": "Não há opções configuráveis ​​para esta conta X-Sense."
    }
  },
