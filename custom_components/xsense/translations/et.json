          "recording_media_sync_enabled": "Salvestusmeediumi sünkroonimine",
          "recording_media_sync_hours": "Taustal sünkroonimise intervall",
          "recording_media_storage_path": "Salvestamise vahemälu kaust",
          "recording_notification_quality": "Teavituste salvestamise kvaliteet",
          "recording_media_days_order": "Salvestuspäeva tellimus",
          "recording_media_clips_order": "Klipi salvestamise tellimus"
        },
        "data_description": {
          "recording_media_sync_enabled": "Salvestage hiljutised salvestised automaatselt vahemällu. See kasutab salvestusruumi ja võib kaameraid sagedamini äratada.",
          "recording_media_sync_hours": "Kui tihti peaks käima tavaline tausta järelsünkroonimine. Kui sünkroonimine on lubatud, kontrollitakse hiljutisi salvestisi iga paari minuti järel.",
          "recording_media_storage_path": "Kasutage /media all olevat kausta. Siia salvestatakse uued vahemällu salvestatud videod ja pisipildid.",
          "recording_notification_quality": "Valige HD, et eelistada mobiilimärguannete jaoks X-Sensei otse-/kõrge eraldusvõimega klipi URL-e. Valige SD, et kasutada kaamera taasesituse jäädvustusteed, kui see on saadaval.",
          "recording_media_days_order": "Valige, kas salvestiste vaatajas kuvatakse esimesena uuemad või vanemad päevad.",
          "recording_media_clips_order": "Valige, kas iga päev kuvatakse esimesena uuemad või vanemad klipid."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "Salvestamise vahemälu kaust muudetakse kaustast `{old_path}` kaustaks `{new_path}`. Olemasolevaid vahemällu salvestatud videoid ja pisipilte ei teisaldata automaatselt. Kui soovite, et vanad vahemällu salvestatud salvestised jääksid kättesaadavaks, teisaldage esmalt olemasolevad kaustad `videos` ja `thumbs`."
