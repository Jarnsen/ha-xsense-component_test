  "options": {
    "step": {
      "init": {
        "description": "Solo riproduzione è la modalità predefinita e inoltra le registrazioni tramite Home Assistant durante la riproduzione senza conservare i clip completi. Scegli di conservare le registrazioni locali per archiviare i clip nei media di Home Assistant usando i limiti di età e dimensione configurati. La sincronizzazione in background funziona solo in modalità conservazione.",
        "data": {
          "recording_media_sync_enabled": "Sincronizzazione del supporto di registrazione",
          "recording_media_sync_hours": "Intervallo di sincronizzazione in background",
          "recording_media_storage_path": "Cartella della cache di registrazione",
          "recording_notification_quality": "Qualità della registrazione delle notifiche",
          "recording_media_days_order": "Ordine del giorno di registrazione",
          "recording_media_clips_order": "Ordine delle clip di registrazione",
          "recording_cache_retention_days": "Conservazione della cache di registrazione",
          "recording_cache_max_size_mb": "Dimensione massima della cache di registrazione",
          "recording_cache_mode": "Modalità di archiviazione delle registrazioni"
        },
        "data_description": {
          "recording_media_sync_enabled": "Memorizza automaticamente nella cache le registrazioni recenti. Ciò utilizza lo spazio di archiviazione e potrebbe riattivare le telecamere più spesso.",
          "recording_media_sync_hours": "La frequenza con cui deve essere eseguita la normale sincronizzazione di recupero in background. Le registrazioni recenti vengono controllate ogni paio di minuti quando la sincronizzazione è abilitata.",
          "recording_media_storage_path": "Utilizza una cartella in /media. I nuovi video e le miniature memorizzati nella cache vengono archiviati qui.",
          "recording_notification_quality": "HD preferisce gli URL delle registrazioni a risoluzione più alta. SD preferisce gli URL a risoluzione standard quando X-Sense li fornisce.",
          "recording_media_days_order": "Scegli se i giorni più nuovi o quelli più vecchi verranno visualizzati per primi nel visualizzatore delle registrazioni.",
          "recording_media_clips_order": "Scegli se le clip più nuove o quelle più vecchie verranno visualizzate per prime ogni giorno.",
          "recording_cache_retention_days": "Elimina le registrazioni memorizzate nella cache locale dopo questo numero di giorni. Le registrazioni su cloud X-Sense e su scheda SD non vengono modificate.",
          "recording_cache_max_size_mb": "Dimensione massima della cache locale in MB. Quando viene raggiunto il limite, le registrazioni visualizzate meno di recente vengono rimosse per prime.",
          "recording_cache_mode": "Solo riproduzione inoltra i contenuti HLS tramite Home Assistant su richiesta senza conservare i clip completi. La modalità conservazione mantiene copie locali usando i limiti indicati sotto."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "La cartella della cache di registrazione cambierà da `{old_path}` a `{new_path}`. I video e le miniature esistenti memorizzati nella cache non vengono spostati automaticamente. Se desideri che le vecchie registrazioni memorizzate nella cache rimangano disponibili, sposta prima le cartelle `hls`, `videos` e `thumbs` esistenti."
      }
    },
    "error": {
      "invalid_recording_media_path": "Utilizza una cartella in /media."
    },
    "abort": {
      "no_options": "Non sono presenti opzioni configurabili per questo account X-Sense."
    }
