  "options": {
    "step": {
      "init": {
        "description": "La sincronizzazione dei supporti di registrazione memorizza nella cache i clip della fotocamera sotto i supporti Home Assistant in modo che la barra laterale delle registrazioni XSENSEBRANDPLACEholder, il browser multimediale e le notifiche mobili possano aprire rapidamente le registrazioni. Lascialo spento per memorizzare nella cache le registrazioni solo quando vengono aperte. Abilitalo per mantenere le registrazioni recenti pronte in background.",
        "data": {
          "recording_media_sync_enabled": "Sincronizzazione del supporto di registrazione",
          "recording_media_sync_hours": "Intervallo di sincronizzazione in background",
          "recording_media_storage_path": "Cartella della cache di registrazione",
          "recording_notification_quality": "Qualità della registrazione delle notifiche",
          "recording_media_days_order": "Ordine del giorno di registrazione",
          "recording_media_clips_order": "Ordine delle clip di registrazione"
        },
        "data_description": {
          "recording_media_sync_enabled": "Memorizza automaticamente nella cache le registrazioni recenti. Ciò utilizza lo spazio di archiviazione e potrebbe riattivare le telecamere più spesso.",
          "recording_media_sync_hours": "La frequenza con cui deve essere eseguita la normale sincronizzazione di recupero in background. Le registrazioni recenti vengono controllate ogni paio di minuti quando la sincronizzazione è abilitata.",
          "recording_media_storage_path": "Utilizza una cartella in MEDIAPATHPLACEholder. I nuovi video e miniature memorizzati nella cache vengono archiviati qui.",
          "recording_notification_quality": "Scegli HD per preferire gli URL di clip diretti/ad alta risoluzione di XSENSEBRANDPLACEholder per le notifiche mobili. Scegli SDPLACEholder per utilizzare il percorso di acquisizione della riproduzione della fotocamera quando disponibile.",
          "recording_media_days_order": "Scegli se i giorni più nuovi o quelli più vecchi verranno visualizzati per primi nel visualizzatore delle registrazioni.",
          "recording_media_clips_order": "Scegli se le clip più nuove o quelle più vecchie verranno visualizzate per prime ogni giorno."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "La cartella della cache di registrazione cambierà da `{old_path}` a `{new_path}`. I video e le miniature esistenti memorizzati nella cache non vengono spostati automaticamente. Se desideri che le vecchie registrazioni memorizzate nella cache rimangano disponibili, sposta prima le cartelle `videos` e `thumbs` esistenti."
      }
    },
    "error": {
