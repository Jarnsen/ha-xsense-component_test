  "options": {
    "step": {
      "init": {
        "description": "Đồng bộ hóa phương tiện ghi sẽ lưu vào bộ nhớ đệm các clip camera trong phương tiện Home Assistant để thanh bên X-Sense Bản ghi, Trình duyệt phương tiện và thông báo trên thiết bị di động có thể mở các bản ghi một cách nhanh chóng. Chỉ để nó vào bộ nhớ đệm khi chúng được mở. Kích hoạt nó để giữ các bản ghi gần đây sẵn sàng ở chế độ nền.",
        "data": {
          "recording_media_sync_enabled": "Ghi đồng bộ hóa phương tiện",
          "recording_media_sync_hours": "Khoảng thời gian đồng bộ hóa nền",
          "recording_media_storage_path": "Ghi thư mục bộ đệm",
          "recording_notification_quality": "Chất lượng ghi thông báo",
          "recording_media_days_order": "Ghi thứ tự ngày",
          "recording_media_clips_order": "Thứ tự ghi clip"
        },
        "data_description": {
          "recording_media_sync_enabled": "Tự động lưu trữ các bản ghi gần đây. Điều này sử dụng không gian lưu trữ và có thể đánh thức camera thường xuyên hơn.",
          "recording_media_sync_hours": "Tần suất chạy đồng bộ hóa bắt kịp nền thông thường. Các bản ghi gần đây được kiểm tra vài phút một lần khi bật đồng bộ hóa.",
          "recording_media_storage_path": "Sử dụng thư mục trong /media. Các video và hình thu nhỏ mới được lưu trong bộ nhớ đệm được lưu trữ tại đây.",
          "recording_notification_quality": "Chọn HD để ưu tiên URL clip trực tiếp/độ phân giải cao của X-Sense cho thông báo trên thiết bị di động. Chọn SD để sử dụng đường dẫn chụp phát lại của máy ảnh khi khả dụng.",
          "recording_media_days_order": "Chọn xem ngày mới hơn hay cũ hơn sẽ xuất hiện đầu tiên trong trình xem bản ghi.",
          "recording_media_clips_order": "Chọn xem các clip mới hơn hay cũ hơn sẽ xuất hiện đầu tiên trong mỗi ngày."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "Thư mục bộ đệm ghi âm sẽ thay đổi từ `{old_path}` thành `{new_path}`. Các video và hình thu nhỏ hiện có trong bộ nhớ đệm không được di chuyển tự động. Trước tiên, hãy di chuyển các thư mục `videos` và `thumbs` hiện có nếu bạn muốn các bản ghi cũ được lưu trong bộ nhớ đệm vẫn khả dụng."
      }
    },
    "error": {
      "invalid_recording_media_path": "Sử dụng thư mục trong /media."
    },
    "abort": {
      "no_options": "Không có tùy chọn có thể định cấu hình nào cho tài khoản X-Sense này."
    }
