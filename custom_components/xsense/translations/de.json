  "options": {
    "step": {
      "init": {
        "description": "Nur Wiedergabe ist die Standardeinstellung und leitet Aufnahmen beim Abspielen über Home Assistant weiter, ohne vollständige Clips zu speichern. Wählen Sie lokale Aufnahmen behalten, um Clips unter Home-Assistant-Medien mit den festgelegten Alters- und Größenlimits zu speichern. Die Hintergrundsynchronisierung läuft nur im Beibehalten-Modus.",
        "data": {
          "recording_media_sync_enabled": "Synchronisierung der Aufnahmemedien",
          "recording_media_sync_hours": "Hintergrundsynchronisierungsintervall",
          "recording_media_storage_path": "Aufnahme-Cache-Ordner",
          "recording_notification_quality": "Qualität der Benachrichtigungsaufzeichnung",
          "recording_media_days_order": "Reihenfolge der Aufnahmetage",
          "recording_media_clips_order": "Reihenfolge der Aufnahmeclips",
          "recording_cache_retention_days": "Cache-Aufbewahrung aufzeichnen",
          "recording_cache_max_size_mb": "Maximale Größe des Aufzeichnungscache",
          "recording_cache_mode": "Speichermodus für Aufnahmen"
        },
        "data_description": {
          "recording_media_sync_enabled": "Aktuelle Aufnahmen automatisch zwischenspeichern. Dadurch wird Speicherplatz beansprucht und die Kameras können möglicherweise häufiger aktiviert werden.",
          "recording_media_sync_hours": "Wie oft die normale Nachholsynchronisierung im Hintergrund ausgeführt werden soll. Aktuelle Aufnahmen werden alle paar Minuten überprüft, wenn die Synchronisierung aktiviert ist.",
          "recording_media_storage_path": "Verwenden Sie einen Ordner unter /media. Hier werden neue zwischengespeicherte Videos und Miniaturansichten gespeichert.",
          "recording_notification_quality": "HD bevorzugt Aufnahme-URLs mit höherer Auflösung. SD bevorzugt URLs mit Standardauflösung, wenn X-Sense diese bereitstellt.",
          "recording_media_days_order": "Wählen Sie, ob neuere oder ältere Tage zuerst im Aufzeichnungsviewer angezeigt werden.",
          "recording_media_clips_order": "Wählen Sie, ob neuere oder ältere Clips an jedem Tag zuerst angezeigt werden.",
          "recording_cache_retention_days": "Löschen Sie lokal zwischengespeicherte Aufzeichnungen nach dieser Anzahl von Tagen. X-Sense-Cloud- und SD-Kartenaufzeichnungen werden nicht verändert.",
          "recording_cache_max_size_mb": "Maximale lokale Cachegröße in MB. Wenn das Limit erreicht ist, werden zuerst die Aufnahmen entfernt, deren letzter Aufruf am längsten zurückliegt.",
          "recording_cache_mode": "Nur Wiedergabe leitet HLS-Medien bei Bedarf über Home Assistant weiter, ohne vollständige Clips zu speichern. Der Beibehalten-Modus speichert lokale Kopien mit den unten festgelegten Limits."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "Der Aufnahme-Cache-Ordner ändert sich von `{old_path}` zu `{new_path}`. Vorhandene zwischengespeicherte Videos und Miniaturansichten werden nicht automatisch verschoben. Verschieben Sie zuerst die vorhandenen Ordner `hls`, `videos` und `thumbs`, wenn alte zwischengespeicherte Aufnahmen weiterhin verfügbar bleiben sollen."
      }
    },
    "error": {
      "invalid_recording_media_path": "Verwenden Sie einen Ordner unter /media."
    },
    "abort": {
      "no_options": "Für dieses X-Sense-Konto gibt es keine konfigurierbaren Optionen."
    }
  },
