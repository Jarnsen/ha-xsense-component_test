  "options": {
    "step": {
      "init": {
        "description": "Predvolený režim je iba prehrávanie: nahrávky sa počas prehrávania prenášajú cez Home Assistant bez uchovávania celých klipov. Ak chcete ukladať klipy do médií Home Assistant podľa nastavených limitov veku a veľkosti, vyberte uchovávanie miestnych nahrávok. Synchronizácia na pozadí beží iba v režime uchovávania.",
        "data": {
          "recording_media_sync_enabled": "Synchronizácia záznamov",
          "recording_media_sync_hours": "Interval synchronizácie na pozadí",
          "recording_media_storage_path": "Priečinok vyrovnávacej pamäte záznamov",
          "recording_notification_quality": "Kvalita záznamu upozornení",
          "recording_media_days_order": "Poradie dní záznamov",
          "recording_media_clips_order": "Poradie klipov záznamov",
          "recording_cache_retention_days": "Uchovávanie vyrovnávacej pamäte nahrávania",
          "recording_cache_max_size_mb": "Maximálna veľkosť vyrovnávacej pamäte nahrávania",
          "recording_cache_mode": "Režim ukladania nahrávok"
        },
        "data_description": {
          "recording_media_sync_enabled": "Automaticky ukladať posledné nahrávky do vyrovnávacej pamäte. Toto využíva úložný priestor a môže častejšie prebúdzať kamery.",
          "recording_media_sync_hours": "Ako často by sa mala spustiť normálna synchronizácia na pozadí. Ak je zapnutá synchronizácia, posledné nahrávky sa kontrolujú každých pár minút.",
          "recording_media_storage_path": "Použite priečinok pod /media. Tu sa ukladajú nové videá a miniatúry uložené vo vyrovnávacej pamäti.",
          "recording_notification_quality": "HD uprednostňuje adresy záznamov s vyšším rozlíšením. SD uprednostňuje štandardné rozlíšenie, ak ho X-Sense poskytuje.",
          "recording_media_days_order": "Vyberte, či sa novšie alebo staršie dni zobrazia ako prvé v prehliadači nahrávok.",
          "recording_media_clips_order": "Vyberte, či sa novšie alebo staršie klipy zobrazia ako prvé v rámci každého dňa.",
          "recording_cache_retention_days": "Po uplynutí tohto počtu dní odstráňte lokálne uložené nahrávky. Cloud X-Sense a záznamy na SD karte sa nezmenia.",
          "recording_cache_max_size_mb": "Maximálna veľkosť lokálnej vyrovnávacej pamäte v MB. Po dosiahnutí limitu sa najskôr odstránia nahrávky, ktoré ste pozerali naposledy.",
          "recording_cache_mode": "Iba prehrávanie prenáša médiá HLS na požiadanie cez Home Assistant bez uchovávania celých klipov. Režim uchovávania ponecháva miestne kópie podľa limitov nižšie."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "Priečinok vyrovnávacej pamäte nahrávania sa zmení z `{old_path}` na `{new_path}`. Existujúce videá a miniatúry vo vyrovnávacej pamäti sa nepresúvajú automaticky. Ak chcete, aby staré nahrávky vo vyrovnávacej pamäti zostali dostupné, najskôr presuňte existujúce priečinky `hls`, `videos` a `thumbs`."
      }
