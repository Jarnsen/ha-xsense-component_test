  "options": {
    "step": {
      "init": {
        "description": "Synchronizácia nahrávacích médií ukladá do vyrovnávacej pamäte klipy z fotoaparátu pod médiá Home Assistant, takže postranný panel Nahrávok X-Sense, Prehliadač médií a mobilné upozornenia môžu rýchlo otvárať nahrávky. Ponechajte ho vypnuté, aby sa záznamy ukladali do vyrovnávacej pamäte iba vtedy, keď sú otvorené. Povoľte ju, aby boli najnovšie nahrávky pripravené na pozadí.",
        "data": {
          "recording_media_sync_enabled": "Recording media sync",
          "recording_media_sync_hours": "Background sync interval",
          "recording_media_storage_path": "Recording cache folder",
          "recording_notification_quality": "Kvalita záznamu upozornení",
          "recording_media_days_order": "Recording day order",
          "recording_media_clips_order": "Recording clip order"
        },
        "data_description": {
          "recording_media_sync_enabled": "Automaticky ukladať posledné nahrávky do vyrovnávacej pamäte. Toto využíva úložný priestor a môže častejšie prebúdzať kamery.",
          "recording_media_sync_hours": "Ako často by sa mala spustiť normálna synchronizácia na pozadí. Ak je zapnutá synchronizácia, posledné nahrávky sa kontrolujú každých pár minút.",
          "recording_media_storage_path": "Použite priečinok pod /media. Tu sa ukladajú nové videá a miniatúry uložené vo vyrovnávacej pamäti.",
          "recording_notification_quality": "Vyberte HD, ak chcete uprednostňovať priame adresy URL klipov / klipov vo vysokom rozlíšení X-Sense pre mobilné upozornenia. Zvoľte SD, ak chcete použiť cestu snímania pri prehrávaní z fotoaparátu, ak je k dispozícii.",
          "recording_media_days_order": "Vyberte, či sa novšie alebo staršie dni zobrazia ako prvé v prehliadači nahrávok.",
          "recording_media_clips_order": "Vyberte, či sa novšie alebo staršie klipy zobrazia ako prvé v rámci každého dňa."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "Priečinok vyrovnávacej pamäte nahrávania sa zmení z `{old_path}` na `{new_path}`. Existujúce videá a miniatúry vo vyrovnávacej pamäti sa nepresúvajú automaticky. Ak chcete, aby staré nahrávky vo vyrovnávacej pamäti zostali dostupné, najskôr presuňte existujúce priečinky `videos` a `thumbs`."
      }
    },
    "error": {
      "invalid_recording_media_path": "Použite priečinok pod /media."
    },
