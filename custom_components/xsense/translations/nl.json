  "options": {
    "step": {
      "init": {
        "description": "Bij het synchroniseren van opnamemedia worden camerafragmenten in de cache opgeslagen onder Home Assistant-media, zodat de zijbalk Opnames van X-Sense, de mediabrowser en mobiele meldingen opnames snel kunnen openen. Laat het uitgeschakeld om opnames alleen in de cache op te slaan wanneer ze worden geopend. Schakel het in om recente opnamen op de achtergrond gereed te houden.",
        "data": {
          "recording_media_sync_enabled": "Synchronisatie van opnamemedia",
          "recording_media_sync_hours": "Achtergrondsynchronisatie-interval",
          "recording_media_storage_path": "Opnamecachemap",
          "recording_notification_quality": "Opnamekwaliteit van meldingen",
          "recording_media_days_order": "Dagvolgorde opnemen",
          "recording_media_clips_order": "Volgorde van opnameclips"
        },
        "data_description": {
          "recording_media_sync_enabled": "Cache recente opnames automatisch. Dit gebruikt opslagruimte en kan camera's vaker activeren.",
          "recording_media_sync_hours": "Hoe vaak de normale inhaalsynchronisatie op de achtergrond moet worden uitgevoerd. Recente opnamen worden elke paar minuten gecontroleerd wanneer synchronisatie is ingeschakeld.",
          "recording_media_storage_path": "Gebruik een map onder /media. Nieuwe in de cache opgeslagen video's en thumbnails worden hier opgeslagen.",
          "recording_notification_quality": "Kies HD om de voorkeur te geven aan de directe clip-URL's/clip-URL's van X-Sense voor mobiele meldingen. Kies SD om het opnamepad voor het afspelen van de camera te gebruiken, indien beschikbaar.",
          "recording_media_days_order": "Kies of nieuwere of oudere dagen eerst verschijnen in de opnameviewer.",
          "recording_media_clips_order": "Kies of nieuwere of oudere clips elke dag als eerste verschijnen."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "De map voor de opnamecache verandert van `{old_path}` in `{new_path}`. Bestaande video's en thumbnails in de cache worden niet automatisch verplaatst. Verplaats eerst de bestaande mappen `videos` en `thumbs` als u wilt dat oude opnamen in de cache beschikbaar blijven."
      }
    },
    "error": {
      "invalid_recording_media_path": "Gebruik een map onder /media."
    },
