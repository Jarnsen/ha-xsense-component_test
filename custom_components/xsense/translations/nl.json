          "recording_media_sync_enabled": "Synchronisatie van opnamemedia",
          "recording_media_sync_hours": "Achtergrondsynchronisatie-interval",
          "recording_media_storage_path": "Opnamecachemap",
          "recording_notification_quality": "Opnamekwaliteit van meldingen",
          "recording_media_days_order": "Dagvolgorde opnemen",
          "recording_media_clips_order": "Volgorde van opnameclips",
          "recording_cache_retention_days": "Retentie van opnamecache",
          "recording_cache_max_size_mb": "Maximale grootte van de opnamecache",
          "recording_cache_mode": "Opslagmodus voor opnamen"
        },
        "data_description": {
          "recording_media_sync_enabled": "Cache recente opnames automatisch. Dit gebruikt opslagruimte en kan camera's vaker activeren.",
          "recording_media_sync_hours": "Hoe vaak de normale inhaalsynchronisatie op de achtergrond moet worden uitgevoerd. Recente opnamen worden elke paar minuten gecontroleerd wanneer synchronisatie is ingeschakeld.",
          "recording_media_storage_path": "Gebruik een map onder /media. Nieuwe in de cache opgeslagen video's en thumbnails worden hier opgeslagen.",
          "recording_notification_quality": "HD geeft voorkeur aan opname-URL's met hogere resolutie. SD geeft voorkeur aan standaardresolutie wanneer X-Sense die beschikbaar stelt.",
          "recording_media_days_order": "Kies of nieuwere of oudere dagen eerst verschijnen in de opnameviewer.",
          "recording_media_clips_order": "Kies of nieuwere of oudere clips elke dag als eerste verschijnen.",
          "recording_cache_retention_days": "Verwijder lokale opnamen in de cache na dit aantal dagen. X-Sense cloud- en SD-kaartopnamen worden niet gewijzigd.",
          "recording_cache_max_size_mb": "Maximale lokale cachegrootte in MB. Wanneer de limiet is bereikt, worden de minst recent bekeken opnames als eerste verwijderd.",
          "recording_cache_mode": "Alleen afspelen stuurt HLS-media op aanvraag via Home Assistant door zonder volledige clips te bewaren. De bewaarmodus houdt lokale kopieën bij volgens de onderstaande limieten."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "De map voor de opnamecache verandert van `{old_path}` in `{new_path}`. Bestaande video's en thumbnails in de cache worden niet automatisch verplaatst. Verplaats eerst de bestaande mappen `hls`, `videos` en `thumbs` als u wilt dat oude opnamen in de cache beschikbaar blijven."
      }
    },
