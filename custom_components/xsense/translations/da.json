          "recording_media_clips_order": "Optagelse af klip rækkefølge",
          "recording_cache_retention_days": "Optagelsescache-opbevaring",
          "recording_cache_max_size_mb": "Maksimal optagecachestørrelse",
          "recording_cache_mode": "Lagringstilstand for optagelser"
        },
        "data_description": {
          "recording_media_sync_enabled": "Cache de seneste optagelser automatisk. Dette bruger lagerplads og kan vække kameraer oftere.",
          "recording_media_sync_hours": "Hvor ofte den normale baggrundssynkronisering skal køre. Nylige optagelser kontrolleres hvert par minutter, når synkronisering er aktiveret.",
          "recording_media_storage_path": "Brug en mappe under /media. Nye cachelagrede videoer og thumbnails gemmes her.",
          "recording_notification_quality": "HD foretrækker optagelses-URL'er med højere opløsning. SD foretrækker standardopløsning, når X-Sense stiller den til rådighed.",
          "recording_media_days_order": "Vælg, om nyere eller ældre dage vises først i optagelsesfremviseren.",
          "recording_media_clips_order": "Vælg, om nyere eller ældre klip vises først inden for hver dag.",
          "recording_cache_retention_days": "Slet lokale cachelagrede optagelser efter disse mange dage. X-Sense cloud- og SD-kortoptagelser ændres ikke.",
          "recording_cache_max_size_mb": "Maksimal lokal cachestørrelse i MB. Når grænsen er nået, fjernes først de optagelser, der ikke er blevet set i længst tid.",
          "recording_cache_mode": "Kun afspilning videresender HLS-medier gennem Home Assistant efter behov uden at gemme hele klip. Lagringstilstand beholder lokale kopier efter grænserne nedenfor."
