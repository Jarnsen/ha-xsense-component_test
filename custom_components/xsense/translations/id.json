  "options": {
    "step": {
      "init": {
        "description": "Merekam sinkronisasi media menyimpan cache klip kamera di bawah media Home Assistant sehingga sidebar Rekaman X-Sense, Browser Media, dan notifikasi seluler dapat membuka rekaman dengan cepat. Biarkan rekaman disimpan dalam cache hanya ketika dibuka. Aktifkan untuk menyimpan rekaman terbaru di latar belakang.",
        "data": {
          "recording_media_sync_enabled": "Merekam sinkronisasi media",
          "recording_media_sync_hours": "Interval sinkronisasi latar belakang",
          "recording_media_storage_path": "Merekam folder cache",
          "recording_notification_quality": "Kualitas rekaman notifikasi",
          "recording_media_days_order": "Merekam pesanan hari",
          "recording_media_clips_order": "Merekam urutan klip"
        },
        "data_description": {
          "recording_media_sync_enabled": "Cache rekaman terbaru secara otomatis. Tindakan ini menghabiskan ruang penyimpanan dan mungkin lebih sering membangunkan kamera.",
          "recording_media_sync_hours": "Seberapa sering sinkronisasi pengejar latar belakang normal harus dijalankan. Rekaman terbaru diperiksa setiap beberapa menit saat sinkronisasi diaktifkan.",
          "recording_media_storage_path": "Gunakan folder di bawah /media. Video dan thumbnail baru yang di-cache disimpan di sini.",
          "recording_notification_quality": "Pilih HD untuk memilih URL klip langsung/resolusi tinggi X-Sense untuk notifikasi seluler. Pilih SD untuk menggunakan jalur pengambilan pemutaran kamera bila tersedia.",
          "recording_media_days_order": "Pilih apakah hari yang lebih baru atau lebih lama muncul pertama kali di penampil rekaman.",
          "recording_media_clips_order": "Pilih apakah klip baru atau lama muncul pertama kali setiap hari."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "Folder cache rekaman akan berubah dari `{old_path}` menjadi `{new_path}`. Video dan thumbnail yang ada dalam cache tidak dipindahkan secara otomatis. Pindahkan folder `videos` dan `thumbs` yang ada terlebih dahulu jika Anda ingin rekaman cache lama tetap tersedia."
      }
    },
    "error": {
      "invalid_recording_media_path": "Gunakan folder di bawah /media."
    },
