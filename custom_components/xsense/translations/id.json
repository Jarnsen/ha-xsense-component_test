          "recording_media_days_order": "Merekam pesanan hari",
          "recording_media_clips_order": "Merekam urutan klip",
          "recording_cache_retention_days": "Merekam retensi cache",
          "recording_cache_max_size_mb": "Ukuran cache rekaman maksimum",
          "recording_cache_mode": "Mode penyimpanan rekaman"
        },
        "data_description": {
          "recording_media_sync_enabled": "Cache rekaman terbaru secara otomatis. Tindakan ini menghabiskan ruang penyimpanan dan mungkin lebih sering membangunkan kamera.",
          "recording_media_sync_hours": "Seberapa sering sinkronisasi pengejar latar belakang normal harus dijalankan. Rekaman terbaru diperiksa setiap beberapa menit saat sinkronisasi diaktifkan.",
          "recording_media_storage_path": "Gunakan folder di bawah /media. Video dan thumbnail baru yang di-cache disimpan di sini.",
          "recording_notification_quality": "HD mengutamakan URL rekaman beresolusi lebih tinggi. SD mengutamakan resolusi standar jika disediakan oleh X-Sense.",
          "recording_media_days_order": "Pilih apakah hari yang lebih baru atau lebih lama muncul pertama kali di penampil rekaman.",
          "recording_media_clips_order": "Pilih apakah klip baru atau lama muncul pertama kali setiap hari.",
          "recording_cache_retention_days": "Hapus rekaman cache lokal setelah beberapa hari ini. Rekaman cloud X-Sense dan kartu SD tidak diubah.",
          "recording_cache_max_size_mb": "Ukuran cache lokal maksimum dalam MB. Bila batasnya tercapai, rekaman yang terakhir dilihat akan dihapus terlebih dahulu.",
          "recording_cache_mode": "Hanya pemutaran meneruskan media HLS melalui Home Assistant sesuai permintaan tanpa menyimpan klip lengkap. Mode penyimpanan menyimpan salinan lokal dengan batas di bawah ini."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "Folder cache rekaman akan berubah dari `{old_path}` menjadi `{new_path}`. Video dan thumbnail yang ada dalam cache tidak dipindahkan secara otomatis. Pindahkan folder `hls`, `videos` dan `thumbs` yang ada terlebih dahulu jika Anda ingin rekaman cache lama tetap tersedia."
      }
