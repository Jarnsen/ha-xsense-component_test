          "recording_media_sync_enabled": "Tallennusmedian synkronointi",
          "recording_media_sync_hours": "Taustasynkronointiväli",
          "recording_media_storage_path": "Tallennusvälimuistikansio",
          "recording_notification_quality": "Ilmoituksen tallennuslaatu",
          "recording_media_days_order": "Tallennuspäivän tilaus",
          "recording_media_clips_order": "Tallennusleikkeen tilaus",
          "recording_cache_retention_days": "Tallennusvälimuistin säilytys",
          "recording_cache_max_size_mb": "Tallennusvälimuistin enimmäiskoko",
          "recording_cache_mode": "Tallenteiden tallennustila"
        },
        "data_description": {
          "recording_media_sync_enabled": "Tallenna viimeisimmät tallenteet automaattisesti välimuistiin. Tämä käyttää tallennustilaa ja saattaa herättää kamerat useammin.",
          "recording_media_sync_hours": "Kuinka usein normaalin taustasynkronoinnin tulee olla käynnissä. Viimeisimmät tallenteet tarkistetaan muutaman minuutin välein, kun synkronointi on käytössä.",
          "recording_media_storage_path": "Käytä /media-kohdassa olevaa kansiota. Uudet välimuistissa olevat videot ja pikkukuvat tallennetaan tänne.",
          "recording_notification_quality": "HD suosii tallenteiden korkeamman resoluution URL-osoitteita. SD suosii vakioresoluutiota, kun X-Sense tarjoaa sen.",
          "recording_media_days_order": "Valitse, näkyvätkö tallenteiden katseluohjelmassa ensin uudemmat vai vanhemmat päivät.",
          "recording_media_clips_order": "Valitse, näkyvätkö uudemmat vai vanhemmat leikkeet ensimmäisenä joka päivä.",
          "recording_cache_retention_days": "Poista paikalliset välimuistitallenteet tämän monen päivän jälkeen. X-Sense-pilvi- ja SD-kortin tallennukset eivät muutu.",
          "recording_cache_max_size_mb": "Paikallisen välimuistin enimmäiskoko megatavuina. Kun raja saavutetaan, ensin poistetaan tallenteet, joiden viimeisestä katselusta on kulunut eniten aikaa.",
          "recording_cache_mode": "Vain toisto välittää HLS-median pyydettäessä Home Assistantin kautta säilyttämättä kokonaisia leikkeitä. Säilytystila pitää paikalliset kopiot alla olevien rajojen mukaan."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "Tallennusvälimuistikansio vaihtuu `{old_path}`-kansiosta `{new_path}`-kansioon. Olemassa olevia välimuistissa olevia videoita ja pikkukuvia ei siirretä automaattisesti. Siirrä ensin olemassa olevat `hls`, `videos`- ja `thumbs`-kansiot, jos haluat säilyttää vanhat välimuistitallenteet."
      }
    },
