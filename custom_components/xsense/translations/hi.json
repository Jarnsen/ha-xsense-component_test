  "options": {
    "step": {
      "init": {
        "description": "केवल प्लेबैक डिफ़ॉल्ट है और पूरे क्लिप सहेजे बिना चलाते समय रिकॉर्डिंग को Home Assistant के माध्यम से प्रॉक्सी करता है। तय आयु और आकार सीमाओं के साथ Home Assistant मीडिया में क्लिप रखने के लिए स्थानीय रिकॉर्डिंग रखें चुनें। बैकग्राउंड सिंक केवल रखे गए रिकॉर्डिंग मोड में चलता है।",
        "data": {
          "recording_media_sync_enabled": "रिकॉर्डिंग मीडिया सिंक",
          "recording_media_sync_hours": "पृष्ठभूमि समन्वयन अंतराल",
          "recording_media_storage_path": "कैश फ़ोल्डर रिकॉर्डिंग",
          "recording_notification_quality": "अधिसूचना रिकॉर्डिंग गुणवत्ता",
          "recording_media_days_order": "दिन का क्रम रिकार्ड करना",
          "recording_media_clips_order": "रिकॉर्डिंग क्लिप ऑर्डर",
          "recording_cache_retention_days": "कैश प्रतिधारण रिकॉर्डिंग",
          "recording_cache_max_size_mb": "अधिकतम रिकॉर्डिंग कैश आकार",
          "recording_cache_mode": "रिकॉर्डिंग स्टोरेज मोड"
        },
        "data_description": {
          "recording_media_sync_enabled": "हाल की रिकॉर्डिंग को स्वचालित रूप से कैश करें। यह भंडारण स्थान का उपयोग करता है और कैमरे को अधिक बार सक्रिय कर सकता है।",
          "recording_media_sync_hours": "सामान्य पृष्ठभूमि कैच-अप सिंक कितनी बार चलना चाहिए। सिंक सक्षम होने पर हर दो मिनट में हाल की रिकॉर्डिंग की जाँच की जाती है।",
          "recording_media_storage_path": "/media के अंतर्गत एक फ़ोल्डर का उपयोग करें। नए कैश किए गए वीडियो और थंबनेल यहाँ संग्रहीत होते हैं।",
          "recording_notification_quality": "HD अधिक रिज़ॉल्यूशन वाली रिकॉर्डिंग के URL को प्राथमिकता देता है। SD उपलब्ध होने पर X-Sense के मानक रिज़ॉल्यूशन वाले URL को प्राथमिकता देता है।",
          "recording_media_days_order": "चुनें कि रिकॉर्डिंग व्यूअर में नए या पुराने दिन पहले दिखें या नहीं।",
          "recording_media_clips_order": "चुनें कि क्या नई या पुरानी क्लिप प्रत्येक दिन सबसे पहले दिखाई देंगी।",
          "recording_cache_retention_days": "इतने दिनों के बाद स्थानीय कैश्ड रिकॉर्डिंग हटा दें। एक्स-सेंस क्लाउड और एसडी कार्ड रिकॉर्डिंग नहीं बदली गई हैं।",
          "recording_cache_max_size_mb": "एमबी में अधिकतम स्थानीय कैश आकार। जब सीमा पूरी हो जाती है, तो सबसे पहले सबसे कम देखी गई रिकॉर्डिंग हटा दी जाती है।",
          "recording_cache_mode": "केवल प्लेबैक पूरे क्लिप सहेजे बिना मांग पर HLS मीडिया को Home Assistant के माध्यम से प्रॉक्सी करता है। रिकॉर्डिंग रखने वाला मोड नीचे की सीमाओं के अनुसार स्थानीय प्रतियां रखता है।"
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "रिकॉर्डिंग कैश फ़ोल्डर `{old_path}` से `{new_path}` में बदल जाएगा। मौजूदा कैश्ड वीडियो और थंबनेल स्वचालित रूप से स्थानांतरित नहीं होते हैं। यदि आप चाहते हैं कि पुरानी कैश्ड रिकॉर्डिंग उपलब्ध रहे तो पहले मौजूदा `hls`, `videos` और `thumbs` फ़ोल्डर्स को स्थानांतरित करें।"
      }
    },
