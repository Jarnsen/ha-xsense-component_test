  "options": {
    "step": {
      "init": {
        "description": "रिकॉर्डिंग मीडिया सिंक Home Assistant मीडिया के अंतर्गत कैमरा क्लिप को कैश करता है ताकि X-Sense रिकॉर्डिंग साइडबार, मीडिया ब्राउज़र और मोबाइल नोटिफिकेशन रिकॉर्डिंग को जल्दी से खोल सकें। रिकॉर्डिंग खुलने पर ही उसे कैश करने के लिए छोड़ दें। हाल की रिकॉर्डिंग को पृष्ठभूमि में तैयार रखने के लिए इसे सक्षम करें।",
        "data": {
          "recording_media_sync_enabled": "रिकॉर्डिंग मीडिया सिंक",
          "recording_media_sync_hours": "पृष्ठभूमि समन्वयन अंतराल",
          "recording_media_storage_path": "कैश फ़ोल्डर रिकॉर्डिंग",
          "recording_notification_quality": "अधिसूचना रिकॉर्डिंग गुणवत्ता",
          "recording_media_days_order": "दिन का क्रम रिकार्ड करना",
          "recording_media_clips_order": "रिकॉर्डिंग क्लिप ऑर्डर"
        },
        "data_description": {
          "recording_media_sync_enabled": "हाल की रिकॉर्डिंग को स्वचालित रूप से कैश करें। यह भंडारण स्थान का उपयोग करता है और कैमरे को अधिक बार सक्रिय कर सकता है।",
          "recording_media_sync_hours": "सामान्य पृष्ठभूमि कैच-अप सिंक कितनी बार चलना चाहिए। सिंक सक्षम होने पर हर दो मिनट में हाल की रिकॉर्डिंग की जाँच की जाती है।",
          "recording_media_storage_path": "मीडियापाथप्लेसहोल्डर के अंतर्गत एक फ़ोल्डर का उपयोग करें। नए कैश्ड वीडियो और थंबनेल यहां संग्रहीत हैं।",
          "recording_notification_quality": "मोबाइल सूचनाओं के लिए X-Sense के प्रत्यक्ष/उच्च-रिज़ॉल्यूशन क्लिप यूआरएल को प्राथमिकता देने के लिए HD चुनें। उपलब्ध होने पर कैमरा प्लेबैक कैप्चर पथ का उपयोग करने के लिए SD चुनें।",
          "recording_media_days_order": "चुनें कि रिकॉर्डिंग व्यूअर में नए या पुराने दिन पहले दिखें या नहीं।",
          "recording_media_clips_order": "चुनें कि क्या नई या पुरानी क्लिप प्रत्येक दिन सबसे पहले दिखाई देंगी।"
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "रिकॉर्डिंग कैश फ़ोल्डर `{old_path}` से `{new_path}` में बदल जाएगा। मौजूदा कैश्ड वीडियो और थंबनेल स्वचालित रूप से स्थानांतरित नहीं होते हैं। यदि आप चाहते हैं कि पुरानी कैश्ड रिकॉर्डिंग उपलब्ध रहे तो पहले मौजूदा वीडियोप्लेसहोल्डर और थंबप्लेसहोल्डर फ़ोल्डर्स को स्थानांतरित करें।"
      }
    },
    "error": {
      "invalid_recording_media_path": "मीडियापाथप्लेसहोल्डर के अंतर्गत एक फ़ोल्डर का उपयोग करें।"
    },
    "abort": {
