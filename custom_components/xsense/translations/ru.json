  "options": {
    "step": {
      "init": {
        "description": "По умолчанию используется режим только воспроизведения: записи передаются через Home Assistant во время просмотра без сохранения полных клипов. Выберите сохранение локальных записей, чтобы хранить клипы в медиа Home Assistant с заданными ограничениями по возрасту и размеру. Фоновая синхронизация работает только в режиме сохранения.",
        "data": {
          "recording_media_sync_enabled": "Синхронизация носителей записи",
          "recording_media_sync_hours": "Интервал фоновой синхронизации",
          "recording_media_storage_path": "Папка кэша записи",
          "recording_notification_quality": "Качество записи уведомлений",
          "recording_media_days_order": "Порядок дня записи",
          "recording_media_clips_order": "Порядок записи клипов",
          "recording_cache_retention_days": "Сохранение кэша записи",
          "recording_cache_max_size_mb": "Максимальный размер кэша записи",
          "recording_cache_mode": "Режим хранения записей"
        },
        "data_description": {
          "recording_media_sync_enabled": "Автоматически кэшируйте последние записи. Это требует места для хранения и может привести к более частому пробуждению камер.",
          "recording_media_sync_hours": "Как часто должна выполняться обычная фоновая синхронизация. Последние записи проверяются каждые пару минут, когда синхронизация включена.",
          "recording_media_storage_path": "Используйте папку в разделе /media. Здесь хранятся новые кэшированные видео и миниатюры.",
          "recording_notification_quality": "HD предпочитает ссылки на записи с более высоким разрешением. SD предпочитает стандартное разрешение, если X-Sense его предоставляет.",
          "recording_media_days_order": "Выберите, будут ли в средстве просмотра записей первыми отображаться более новые или более старые дни.",
          "recording_media_clips_order": "Выберите, будут ли новые или старые клипы появляться первыми в течение дня.",
          "recording_cache_retention_days": "Удалите локальные кэшированные записи по истечении этого количества дней. Записи X-Sense Cloud и SD-карты не изменяются.",
          "recording_cache_max_size_mb": "Максимальный размер локального кэша в МБ. При достижении лимита первыми удаляются записи, просматривавшиеся реже всего.",
          "recording_cache_mode": "Режим только воспроизведения передаёт HLS-медиа через Home Assistant по запросу без сохранения полных клипов. Режим сохранения хранит локальные копии с указанными ниже ограничениями."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "Папка кэша записи изменится с `{old_path}` на `{new_path}`. Существующие кэшированные видео и миниатюры не перемещаются автоматически. Сначала переместите существующие папки `hls`, `videos` и `thumbs`, если вы хотите, чтобы старые кэшированные записи оставались доступными."
      }
    },
    "error": {
      "invalid_recording_media_path": "Используйте папку в разделе /media."
    },
    "abort": {
      "no_options": "Для этой учетной записи X-Sense нет настраиваемых параметров."
    }
  },
