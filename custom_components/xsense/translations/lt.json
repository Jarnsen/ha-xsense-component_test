  "options": {
    "step": {
      "init": {
        "description": "Įrašymo laikmenos sinchronizavimas talpykloje išsaugo fotoaparato klipus Home Assistant laikmenoje, todėl šoninė įrašų juosta X-Sense, medijos naršyklė ir pranešimai mobiliesiems gali greitai atidaryti įrašus. Palikite jį į talpyklos įrašus tik tada, kai jie atidaromi. Įjunkite, kad naujausi įrašai būtų paruošti fone.",
        "data": {
          "recording_media_sync_enabled": "Įrašymo laikmenos sinchronizavimas",
          "recording_media_sync_hours": "Fono sinchronizavimo intervalas",
          "recording_media_storage_path": "Įrašymo talpyklos aplankas",
          "recording_notification_quality": "Pranešimų įrašymo kokybė",
          "recording_media_days_order": "Įrašymo dienos užsakymas",
          "recording_media_clips_order": "Įrašymo klipo užsakymas"
        },
        "data_description": {
          "recording_media_sync_enabled": "Automatiškai saugokite naujausius įrašus. Tai užima vietos saugykloje ir gali dažniau pažadinti kameras.",
          "recording_media_sync_hours": "Kaip dažnai turėtų vykti įprastas fono pasivijimo sinchronizavimas. Įjungus sinchronizavimą, naujausi įrašai tikrinami kas kelias minutes.",
          "recording_media_storage_path": "Naudokite aplanką, esantį /media. Čia saugomi nauji talpykloje saugomi vaizdo įrašai ir miniatiūros.",
          "recording_notification_quality": "Pasirinkite HD, kad teiktumėte pirmenybę X-Sense tiesioginiams / didelės skyros klipų URL pranešimams mobiliesiems. Pasirinkite SD, jei norite naudoti fotoaparato atkūrimo fiksavimo kelią, kai įmanoma.",
          "recording_media_days_order": "Pasirinkite, ar įrašų peržiūros priemonėje pirmiausia bus rodomos naujesnės ar senesnės dienos.",
          "recording_media_clips_order": "Pasirinkite, ar kiekvieną dieną pirmiausia rodomi naujesni ar senesni klipai."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "Įrašymo talpyklos aplankas pasikeis iš `{old_path}` į `{new_path}`. Esami talpykloje esantys vaizdo įrašai ir miniatiūros neperkeliami automatiškai. Pirmiausia perkelkite esamus aplankus `videos` ir `thumbs`, jei norite, kad seni talpykloje esantys įrašai liktų pasiekiami."
      }
    },
    "error": {
