  "options": {
    "step": {
      "init": {
        "description": "Η προεπιλογή είναι μόνο αναπαραγωγή και προωθεί τις εγγραφές μέσω του Home Assistant κατά την αναπαραγωγή χωρίς να διατηρεί ολόκληρα κλιπ. Επιλέξτε διατήρηση τοπικών εγγραφών για αποθήκευση κλιπ στα πολυμέσα του Home Assistant με τα καθορισμένα όρια ηλικίας και μεγέθους. Ο συγχρονισμός παρασκηνίου εκτελείται μόνο στη λειτουργία διατήρησης.",
        "data": {
          "recording_media_sync_enabled": "Συγχρονισμός μέσων εγγραφής",
          "recording_media_sync_hours": "Διάστημα συγχρονισμού φόντου",
          "recording_media_storage_path": "Εγγραφή φακέλου προσωρινής μνήμης",
          "recording_notification_quality": "Ποιότητα εγγραφής ειδοποιήσεων",
          "recording_media_days_order": "Καταγραφή ημέρας παραγγελίας",
          "recording_media_clips_order": "Παραγγελία κλιπ εγγραφής",
          "recording_cache_retention_days": "Καταγραφή διατήρησης κρυφής μνήμης",
          "recording_cache_max_size_mb": "Μέγιστο μέγεθος κρυφής μνήμης εγγραφής",
          "recording_cache_mode": "Λειτουργία αποθήκευσης εγγραφών"
        },
        "data_description": {
          "recording_media_sync_enabled": "Αποθηκεύστε προσωρινά τις πρόσφατες εγγραφές αυτόματα. Αυτό χρησιμοποιεί χώρο αποθήκευσης και μπορεί να αφυπνίζει τις κάμερες πιο συχνά.",
          "recording_media_sync_hours": "Πόσο συχνά θα πρέπει να εκτελείται ο κανονικός συγχρονισμός παρακολούθησης φόντου. Οι πρόσφατες εγγραφές ελέγχονται κάθε δύο λεπτά όταν είναι ενεργοποιημένος ο συγχρονισμός.",
          "recording_media_storage_path": "Χρησιμοποιήστε έναν φάκελο στην περιοχή /media. Τα νέα αποθηκευμένα βίντεο και μικρογραφίες αποθηκεύονται εδώ.",
          "recording_notification_quality": "Το HD προτιμά URL εγγραφών υψηλότερης ανάλυσης. Το SD προτιμά τυπική ανάλυση όταν παρέχεται από το X-Sense.",
          "recording_media_days_order": "Επιλέξτε εάν οι νεότερες ή παλαιότερες ημέρες θα εμφανίζονται πρώτα στην προβολή εγγραφών.",
          "recording_media_clips_order": "Επιλέξτε εάν νεότερα ή παλαιότερα κλιπ θα εμφανίζονται πρώτα μέσα σε κάθε ημέρα.",
          "recording_cache_retention_days": "Διαγράψτε τοπικές αποθηκευμένες εγγραφές μετά από τόσες μέρες. Οι εγγραφές X-Sense cloud και κάρτας SD δεν αλλάζουν.",
          "recording_cache_max_size_mb": "Μέγιστο μέγεθος τοπικής κρυφής μνήμης σε MB. Όταν συμπληρωθεί το όριο, αφαιρούνται πρώτα οι εγγραφές που προβλήθηκαν λιγότερο πρόσφατα.",
          "recording_cache_mode": "Η λειτουργία μόνο αναπαραγωγής προωθεί πολυμέσα HLS μέσω του Home Assistant κατ’ απαίτηση χωρίς να διατηρεί ολόκληρα κλιπ. Η λειτουργία διατήρησης κρατά τοπικά αντίγραφα με τα παρακάτω όρια."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "Ο φάκελος της προσωρινής μνήμης εγγραφής θα αλλάξει από `{old_path}` σε `{new_path}`. Τα υπάρχοντα αποθηκευμένα βίντεο και μικρογραφίες δεν μετακινούνται αυτόματα. Μετακινήστε πρώτα τους υπάρχοντες φακέλους `hls`, `videos` και `thumbs` εάν θέλετε να παραμείνουν διαθέσιμες παλιές αποθηκευμένες εγγραφές."
      }
    },
