  "options": {
    "step": {
      "init": {
        "description": "Ο συγχρονισμός μέσων εγγραφής αποθηκεύει κλιπ κάμερας κάτω από τα μέσα Home Assistant, έτσι ώστε η πλαϊνή γραμμή εγγραφών X-Sense, το πρόγραμμα περιήγησης πολυμέσων και οι ειδοποιήσεις για κινητά να μπορούν να ανοίγουν τις εγγραφές γρήγορα. Αφήστε το στη μνήμη cache των εγγραφών μόνο όταν ανοίξουν. Ενεργοποιήστε το για να διατηρείτε τις πρόσφατες εγγραφές έτοιμες στο παρασκήνιο.",
        "data": {
          "recording_media_sync_enabled": "Συγχρονισμός μέσων εγγραφής",
          "recording_media_sync_hours": "Διάστημα συγχρονισμού φόντου",
          "recording_media_storage_path": "Εγγραφή φακέλου προσωρινής μνήμης",
          "recording_notification_quality": "Ποιότητα εγγραφής ειδοποιήσεων",
          "recording_media_days_order": "Καταγραφή ημέρας παραγγελίας",
          "recording_media_clips_order": "Παραγγελία κλιπ εγγραφής"
        },
        "data_description": {
          "recording_media_sync_enabled": "Αποθηκεύστε προσωρινά τις πρόσφατες εγγραφές αυτόματα. Αυτό χρησιμοποιεί χώρο αποθήκευσης και μπορεί να αφυπνίζει τις κάμερες πιο συχνά.",
          "recording_media_sync_hours": "Πόσο συχνά θα πρέπει να εκτελείται ο κανονικός συγχρονισμός παρακολούθησης φόντου. Οι πρόσφατες εγγραφές ελέγχονται κάθε δύο λεπτά όταν είναι ενεργοποιημένος ο συγχρονισμός.",
          "recording_media_storage_path": "Χρησιμοποιήστε έναν φάκελο στην περιοχή /media. Τα νέα αποθηκευμένα βίντεο και μικρογραφίες αποθηκεύονται εδώ.",
          "recording_notification_quality": "Επιλέξτε HD για να προτιμήσετε τις διευθύνσεις URL κλιπ απευθείας/υψηλής ανάλυσης του X-Sense για ειδοποιήσεις για κινητά. Επιλέξτε SD για να χρησιμοποιήσετε τη διαδρομή λήψης αναπαραγωγής της κάμερας όταν είναι διαθέσιμη.",
          "recording_media_days_order": "Επιλέξτε εάν οι νεότερες ή παλαιότερες ημέρες θα εμφανίζονται πρώτα στην προβολή εγγραφών.",
          "recording_media_clips_order": "Επιλέξτε εάν νεότερα ή παλαιότερα κλιπ θα εμφανίζονται πρώτα μέσα σε κάθε ημέρα."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "Ο φάκελος της προσωρινής μνήμης εγγραφής θα αλλάξει από `{old_path}` σε `{new_path}`. Τα υπάρχοντα αποθηκευμένα βίντεο και μικρογραφίες δεν μετακινούνται αυτόματα. Μετακινήστε πρώτα τους υπάρχοντες φακέλους `videos` και `thumbs` εάν θέλετε να παραμείνουν διαθέσιμες παλιές αποθηκευμένες εγγραφές."
      }
    },
    "error": {
      "invalid_recording_media_path": "Χρησιμοποιήστε έναν φάκελο στην περιοχή /media."
    },
    "abort": {
      "no_options": "Δεν υπάρχουν επιλογές με δυνατότητα διαμόρφωσης για αυτόν τον λογαριασμό X-Sense."
    }
  },
