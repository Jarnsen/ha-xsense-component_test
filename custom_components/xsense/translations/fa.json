  "options": {
    "step": {
      "init": {
        "description": "همگام سازی رسانه ضبط، کلیپ های دوربین را در حافظه پنهان Home Assistant ذخیره می کند، بنابراین نوار کناری ضبط X-Sense، مرورگر رسانه و اعلان های تلفن همراه می توانند ضبط ها را به سرعت باز کنند. آن را تنها زمانی که ضبط‌ها در حافظه پنهان باز می‌شوند، بگذارید. برای آماده نگه داشتن ضبط های اخیر در پس زمینه، آن را فعال کنید.",
        "data": {
          "recording_media_sync_enabled": "همگام سازی رسانه ضبط",
          "recording_media_sync_hours": "فاصله همگام سازی پس زمینه",
          "recording_media_storage_path": "در حال ضبط پوشه کش",
          "recording_notification_quality": "کیفیت ضبط اعلان",
          "recording_media_days_order": "ثبت سفارش روز",
          "recording_media_clips_order": "سفارش کلیپ ضبط"
        },
        "data_description": {
          "recording_media_sync_enabled": "ضبط های اخیر را به صورت خودکار ذخیره کنید. این از فضای ذخیره سازی استفاده می کند و ممکن است دوربین ها را بیشتر بیدار کند.",
          "recording_media_sync_hours": "هر چند وقت یک‌بار همگام‌سازی عادی پس‌زمینه باید اجرا شود. وقتی همگام‌سازی فعال است، ضبط‌های اخیر هر چند دقیقه بررسی می‌شوند.",
          "recording_media_storage_path": "از پوشه ای در زیر /media استفاده کنید. ویدیوها و تصاویر کوچک ذخیره شده جدید در اینجا ذخیره می شوند.",
          "recording_notification_quality": "HD را انتخاب کنید تا URL های کلیپ مستقیم/با وضوح بالا X-Sense را برای اعلان های تلفن همراه ترجیح دهید. SD را انتخاب کنید تا در صورت موجود بودن از مسیر ضبط پخش دوربین استفاده کنید.",
          "recording_media_days_order": "انتخاب کنید روزهای جدیدتر یا قدیمی‌تر ابتدا در نمایشگر ضبط‌شده ظاهر شوند.",
          "recording_media_clips_order": "انتخاب کنید کلیپ‌های جدیدتر یا قدیمی‌تر ابتدا در هر روز ظاهر شوند."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "پوشه کش ضبط از `{old_path}` به `{new_path}` تغییر می کند. ویدیوها و تصاویر کوچک موجود در حافظه پنهان به طور خودکار جابجا نمی شوند. اگر می‌خواهید ضبط‌های ذخیره شده قدیمی در حافظه پنهان باقی بمانند، ابتدا پوشه‌های `videos` و `thumbs` موجود را جابه‌جا کنید."
      }
    },
    "error": {
      "invalid_recording_media_path": "از پوشه ای در زیر /media استفاده کنید."
    },
    "abort": {
      "no_options": "هیچ گزینه قابل تنظیمی برای این حساب X-Sense وجود ندارد."
    }
  },
