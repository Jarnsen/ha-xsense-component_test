  "options": {
    "step": {
      "init": {
        "description": "Kayıt ortamı senkronizasyonu, kamera kliplerini Home Assistant ortamı altında önbelleğe alır, böylece X-Sense Kayıtlar kenar çubuğu, Medya Tarayıcı ve mobil bildirimler kayıtları hızlı bir şekilde açabilir. Kayıtları yalnızca açıldıklarında önbelleğe almak için bunu kapalı bırakın. Son kayıtları arka planda hazır tutmak için bunu etkinleştirin.",
        "data": {
          "recording_media_sync_enabled": "Medya senkronizasyonu kaydediliyor",
          "recording_media_sync_hours": "Arka planda senkronizasyon aralığı",
          "recording_media_storage_path": "Önbellek klasörü kaydediliyor",
          "recording_notification_quality": "Bildirim kayıt kalitesi",
          "recording_media_days_order": "Kayıt günü sırası",
          "recording_media_clips_order": "Klip sırası kaydediliyor"
        },
        "data_description": {
          "recording_media_sync_enabled": "Son kayıtları otomatik olarak önbelleğe alın. Bu, depolama alanını kullanır ve kameraları daha sık uyandırabilir.",
          "recording_media_sync_hours": "Normal arka plan yakalama senkronizasyonunun ne sıklıkta çalışması gerektiği. Senkronizasyon etkinleştirildiğinde son kayıtlar birkaç dakikada bir kontrol edilir.",
          "recording_media_storage_path": "/media altında bir klasör kullanın. Önbelleğe alınan yeni videolar ve küçük resimler burada saklanır.",
          "recording_notification_quality": "Mobil bildirimler için X-Sense'ın doğrudan/yüksek çözünürlüklü klip URL'lerini tercih etmek için HD'ı seçin. Mümkün olduğunda kamera oynatma yakalama yolunu kullanmak için SD'ı seçin.",
          "recording_media_days_order": "Kayıt görüntüleyicide ilk olarak daha yeni günlerin mi yoksa daha eski günlerin mi görüntüleneceğini seçin.",
          "recording_media_clips_order": "Her gün içinde daha yeni veya daha eski kliplerin ilk önce görünüp görünmeyeceğini seçin."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "Kayıt önbelleği klasörü `{old_path}` yerine `{new_path}` olarak değişecektir. Önbelleğe alınmış mevcut videolar ve küçük resimler otomatik olarak taşınmaz. Önbelleğe alınmış eski kayıtların kullanılabilir kalmasını istiyorsanız önce mevcut `videos` ve `thumbs` klasörlerini taşıyın."
      }
    },
    "error": {
      "invalid_recording_media_path": "/media altında bir klasör kullanın."
    },
