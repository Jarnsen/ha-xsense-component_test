          "recording_media_sync_enabled": "Synkronisering av opptaksmedier",
          "recording_media_sync_hours": "Bakgrunnssynkroniseringsintervall",
          "recording_media_storage_path": "Opptaksbuffermappe",
          "recording_notification_quality": "Varslingsopptakskvalitet",
          "recording_media_days_order": "Bestilling av opptaksdag",
          "recording_media_clips_order": "Opptak av klipprekkefølge"
        },
        "data_description": {
          "recording_media_sync_enabled": "Buffer nylige opptak automatisk. Dette bruker lagringsplass og kan vekke kameraer oftere.",
          "recording_media_sync_hours": "Hvor ofte den vanlige bakgrunnssynkroniseringen skal kjøres. Nylige opptak kontrolleres hvert par minutter når synkronisering er aktivert.",
          "recording_media_storage_path": "Bruk en mappe under /media. Nye bufrede videoer og miniatyrbilder lagres her.",
          "recording_notification_quality": "Velg HD for å foretrekke X-Senses direkte/høyoppløselige klipp-URLer for mobilvarsler. Velg SD for å bruke fangstbanen for kameraavspilling når den er tilgjengelig.",
          "recording_media_days_order": "Velg om nyere eller eldre dager vises først i opptaksvisningen.",
          "recording_media_clips_order": "Velg om nyere eller eldre klipp vises først i løpet av hver dag."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "Opptaksbuffermappen vil endres fra `{old_path}` til `{new_path}`. Eksisterende bufrede videoer og miniatyrbilder flyttes ikke automatisk. Flytt de eksisterende mappene `videos` og `thumbs` først hvis du vil at gamle bufrede opptak skal forbli tilgjengelige."
      }
    },
