  "options": {
    "step": {
      "init": {
        "description": "녹화 미디어 동기화는 Home Assistant 미디어 아래에 카메라 클립을 캐시하므로 X-Sense 녹화 사이드바, 미디어 브라우저 및 모바일 알림이 녹화를 빠르게 열 수 있습니다. 녹음이 열릴 때만 캐시하려면 이 옵션을 꺼두세요. 백그라운드에서 최근 녹음을 준비하려면 활성화하세요.",
        "data": {
          "recording_media_sync_enabled": "녹화 미디어 동기화",
          "recording_media_sync_hours": "백그라운드 동기화 간격",
          "recording_media_storage_path": "녹화 캐시 폴더",
          "recording_notification_quality": "알림 녹음 품질",
          "recording_media_days_order": "녹화일 순서",
          "recording_media_clips_order": "녹화 클립 순서"
        },
        "data_description": {
          "recording_media_sync_enabled": "최근 녹음을 자동으로 캐시합니다. 이는 저장 공간을 사용하며 카메라를 더 자주 깨울 수 있습니다.",
          "recording_media_sync_hours": "일반적인 백그라운드 캐치업 동기화를 실행해야 하는 빈도입니다. 동기화가 활성화되면 최근 녹음은 몇 분마다 확인됩니다.",
          "recording_media_storage_path": "/media 아래의 폴더를 사용하세요. 새로 캐시된 비디오와 썸네일은 여기에 저장됩니다.",
          "recording_notification_quality": "모바일 알림을 위해 X-Sense의 직접/고해상도 클립 URL을 선호하려면 HD를 선택하세요. 가능한 경우 카메라 재생 캡처 경로를 사용하려면 SD를 선택하십시오.",
          "recording_media_days_order": "녹음 뷰어에서 최신 날짜 또는 이전 날짜를 먼저 표시할지 선택합니다.",
          "recording_media_clips_order": "매일 새로운 클립이나 오래된 클립을 먼저 표시할지 선택합니다."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "녹화 캐시 폴더가 `{old_path}`에서 `{new_path}`로 변경됩니다. 기존에 캐시된 비디오와 썸네일은 자동으로 이동되지 않습니다. 오래되고 캐시된 녹화물을 계속 사용하려면 기존 `videos` 및 `thumbs` 폴더를 먼저 이동하세요."
      }
    },
    "error": {
      "invalid_recording_media_path": "/media 아래의 폴더를 사용하세요."
    },
    "abort": {
      "no_options": "이 X-Sense 계정에 대해 구성 가능한 옵션이 없습니다."
    }
  },
