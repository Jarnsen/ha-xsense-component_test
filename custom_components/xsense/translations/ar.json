  "options": {
    "step": {
      "init": {
        "description": "وضع التشغيل فقط هو الافتراضي، ويمرر التسجيلات عبر Home Assistant أثناء تشغيلها دون الاحتفاظ بالمقاطع كاملة. اختر الاحتفاظ بالتسجيلات محليًا لحفظ المقاطع ضمن وسائط Home Assistant وفق حدود العمر والحجم المحددة. تعمل المزامنة في الخلفية فقط في وضع الاحتفاظ.",
        "data": {
          "recording_media_sync_enabled": "تسجيل مزامنة الوسائط",
          "recording_media_sync_hours": "الفاصل الزمني لمزامنة الخلفية",
