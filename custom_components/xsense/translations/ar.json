  "options": {
    "step": {
      "init": {
        "description": "تقوم مزامنة الوسائط المسجلة بتخزين مقاطع الكاميرا مؤقتًا ضمن وسائط Home Assistant حتى يتمكن الشريط الجانبي للتسجيلات X-Sense ومتصفح الوسائط وإشعارات الهاتف المحمول من فتح التسجيلات بسرعة. اتركه للتخزين المؤقت للتسجيلات فقط عند فتحها. قم بتمكينه للحفاظ على التسجيلات الحديثة جاهزة في الخلفية.",
        "data": {
          "recording_media_sync_enabled": "تسجيل مزامنة الوسائط",
          "recording_media_sync_hours": "الفاصل الزمني لمزامنة الخلفية",
          "recording_media_storage_path": "تسجيل مجلد ذاكرة التخزين المؤقت",
          "recording_notification_quality": "جودة تسجيل الإخطار",
          "recording_media_days_order": "تسجيل ترتيب اليوم",
          "recording_media_clips_order": "تسجيل ترتيب المقطع"
        },
        "data_description": {
          "recording_media_sync_enabled": "تخزين التسجيلات الأخيرة تلقائيًا. يستخدم هذا مساحة تخزين وقد يقوم بتنشيط الكاميرات في كثير من الأحيان.",
          "recording_media_sync_hours": "عدد المرات التي يجب أن يتم فيها تشغيل مزامنة اللحاق بالخلفية العادية. يتم فحص التسجيلات الحديثة كل دقيقتين عند تمكين المزامنة.",
          "recording_media_storage_path": "استخدم مجلدًا ضمن /media. يتم تخزين مقاطع الفيديو والصور المصغرة الجديدة المخزنة مؤقتًا هنا.",
          "recording_notification_quality": "اختر HD لتفضيل عناوين URL المباشرة/عالية الدقة لمقاطع X-Sense لإشعارات الهاتف المحمول. اختر SD لاستخدام مسار التقاط تشغيل الكاميرا عندما يكون ذلك متاحًا.",
          "recording_media_days_order": "اختر ما إذا كانت الأيام الأحدث أو الأقدم ستظهر أولاً في عارض التسجيلات.",
          "recording_media_clips_order": "اختر ما إذا كانت المقاطع الأحدث أو الأقدم ستظهر أولاً خلال كل يوم."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "سيتم تغيير مجلد ذاكرة التخزين المؤقت للتسجيل من `{old_path}` إلى `{new_path}`. لا يتم نقل مقاطع الفيديو والصور المصغرة الموجودة المخزنة مؤقتًا تلقائيًا. انقل مجلدي `videos` و`thumbs` الموجودين أولاً إذا كنت تريد أن تظل التسجيلات القديمة المخزنة مؤقتًا متاحة."
      }
    },
    "error": {
      "invalid_recording_media_path": "استخدم مجلدًا ضمن /media."
    },
    "abort": {
      "no_options": "لا توجد خيارات قابلة للتكوين لحساب X-Sense هذا."
    }
  },
