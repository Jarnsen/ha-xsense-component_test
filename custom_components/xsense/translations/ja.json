  "options": {
    "step": {
      "init": {
        "description": "録画メディアの同期により、Home Assistant メディアの下にカメラ クリップがキャッシュされるため、X-Sense 録画サイドバー、メディア ブラウザ、およびモバイル通知で録画をすばやく開くことができます。録画を開いたときにのみキャッシュするには、オフのままにしておきます。最近の録音をバックグラウンドで準備できるようにするには、これを有効にします。",
        "data": {
          "recording_media_sync_enabled": "記録メディアの同期",
          "recording_media_sync_hours": "バックグラウンド同期間隔",
          "recording_media_storage_path": "録画キャッシュフォルダー",
          "recording_notification_quality": "通知記録の品質",
          "recording_media_days_order": "収録日順",
          "recording_media_clips_order": "録音クリップの順序"
        },
        "data_description": {
          "recording_media_sync_enabled": "最近の録音を自動的にキャッシュします。これによりストレージ容量が使用され、カメラがより頻繁にスリープ状態になる可能性があります。",
          "recording_media_sync_hours": "通常のバックグラウンドキャッチアップ同期を実行する頻度。同期が有効になっている場合、最近の録音は数分ごとにチェックされます。",
          "recording_media_storage_path": "/media の下のフォルダーを使用します。新しいキャッシュされたビデオとサムネイルはここに保存されます。",
          "recording_notification_quality": "モバイル通知に X-Sense の直接/高解像度クリップ URL を優先するには、HD を選択します。利用可能な場合は、SD を選択して、カメラ再生キャプチャ パスを使用します。",
          "recording_media_days_order": "録画ビューアに新しい日と古い日のどちらを最初に表示するかを選択します。",
          "recording_media_clips_order": "新しいクリップと古いクリップのどちらを毎日最初に表示するかを選択します。"
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "記録キャッシュ フォルダーが `{old_path}` から `{new_path}` に変更されます。キャッシュされた既存のビデオとサムネイルは自動的に移動されません。キャッシュされた古い録画を引き続き使用できるようにするには、まず既存の `videos` フォルダーと `thumbs` フォルダーを移動します。"
      }
    },
    "error": {
      "invalid_recording_media_path": "/media の下のフォルダーを使用します。"
    },
    "abort": {
      "no_options": "この X-Sense アカウントには構成可能なオプションはありません。"
    }
  },
