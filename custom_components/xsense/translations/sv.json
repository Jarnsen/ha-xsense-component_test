  "options": {
    "step": {
      "init": {
        "description": "Inspelning av mediasynkronisering cachar kameraklipp under Home Assistant media så att X-Sense Recordings sidofältet, mediebläddraren och mobilaviseringar kan öppna inspelningar snabbt. Lämna det avstängt för att cachelagra inspelningar endast när de är öppna. Aktivera den för att hålla de senaste inspelningarna redo i bakgrunden.",
        "data": {
          "recording_media_sync_enabled": "Synkronisering av inspelningsmedia",
          "recording_media_sync_hours": "Bakgrundssynkroniseringsintervall",
          "recording_media_storage_path": "Inspelningscachemapp",
          "recording_notification_quality": "Meddelandeinspelningskvalitet",
          "recording_media_days_order": "Beställning av inspelningsdag",
          "recording_media_clips_order": "Inspelningsordning för klipp"
        },
        "data_description": {
          "recording_media_sync_enabled": "Cachelagra de senaste inspelningarna automatiskt. Detta använder lagringsutrymme och kan väcka kameror oftare.",
          "recording_media_sync_hours": "Hur ofta den normala bakgrundssynkroniseringen ska köras. Senaste inspelningar kontrolleras varannan minut när synkronisering är aktiverad.",
          "recording_media_storage_path": "Använd en mapp under /media. Nya cachade videor och miniatyrer lagras här.",
          "recording_notification_quality": "Välj HD för att föredra X-Senses direkta/högupplösta klippwebbadresser för mobilaviseringar. Välj SD för att använda kamerauppspelningsbanan när den är tillgänglig.",
          "recording_media_days_order": "Välj om nyare eller äldre dagar ska visas först i inspelningsvisningen.",
          "recording_media_clips_order": "Välj om nyare eller äldre klipp ska visas först inom varje dag."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "Inspelningscachemappen ändras från `{old_path}` till `{new_path}`. Befintliga cachade videor och miniatyrer flyttas inte automatiskt. Flytta de befintliga mapparna `videos` och `thumbs` först om du vill att gamla cachade inspelningar ska förbli tillgängliga."
      }
    },
    "error": {
