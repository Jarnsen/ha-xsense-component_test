  "options": {
    "step": {
      "init": {
        "description": "Ierakstīšanas multivides sinhronizēšana kešatmiņā saglabā kameras klipus zem multivides Home Assistant, lai X-Sense ierakstu sānjosla, multivides pārlūkprogramma un mobilie paziņojumi varētu ātri atvērt ierakstus. Atstājiet to izslēgtu, lai saglabātu ierakstus tikai tad, kad tie ir atvērti. Iespējojiet to, lai jaunākie ieraksti būtu gatavi fonā.",
        "data": {
          "recording_media_sync_enabled": "Ierakstīšanas multivides sinhronizācija",
          "recording_media_sync_hours": "Fona sinhronizācijas intervāls",
          "recording_media_storage_path": "Ierakstīšanas kešatmiņas mape",
          "recording_notification_quality": "Paziņojumu ierakstīšanas kvalitāte",
          "recording_media_days_order": "Ierakstīšanas dienas pasūtījums",
          "recording_media_clips_order": "Ierakstīšanas klipa pasūtījums"
        },
        "data_description": {
          "recording_media_sync_enabled": "Automātiski saglabājiet jaunākos ierakstus kešatmiņā. Tas izmanto krātuves vietu un var biežāk pamodināt kameras.",
          "recording_media_sync_hours": "Cik bieži vajadzētu darboties parastajai fona panākšanas sinhronizācijai. Kad sinhronizācija ir iespējota, pēdējie ieraksti tiek pārbaudīti ik pēc pāris minūtēm.",
          "recording_media_storage_path": "Izmantojiet mapi sadaļā /media. Šeit tiek glabāti jauni kešatmiņā saglabātie videoklipi un sīktēli.",
          "recording_notification_quality": "Izvēlieties HD, lai mobilajiem paziņojumiem dotu priekšroku X-Sense tiešajiem/augstas izšķirtspējas klipu vietrāžiem URL. Izvēlieties SD, lai izmantotu kameras atskaņošanas uzņemšanas ceļu, kad tas ir pieejams.",
          "recording_media_days_order": "Izvēlieties, vai ierakstu skatītājā vispirms tiek rādītas jaunākas vai vecākas dienas.",
          "recording_media_clips_order": "Izvēlieties, vai katru dienu vispirms tiek rādīti jaunāki vai vecāki klipi."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "Ierakstu kešatmiņas mape tiks mainīta no `{old_path}` uz `{new_path}`. Esošie kešatmiņā saglabātie videoklipi un sīktēli netiek automātiski pārvietoti. Ja vēlaties, lai vecie kešatmiņā saglabātie ieraksti būtu pieejami, vispirms pārvietojiet esošās mapes `videos` un `thumbs`."
      }
    },
