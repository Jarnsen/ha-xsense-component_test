  "options": {
    "step": {
      "init": {
        "description": "Noklusējums ir tikai atskaņošana: ieraksti atskaņošanas laikā tiek pārsūtīti caur Home Assistant, nesaglabājot pilnus klipus. Izvēlieties vietējo ierakstu saglabāšanu, lai glabātu klipus Home Assistant multividē atbilstoši iestatītajiem vecuma un izmēra ierobežojumiem. Fona sinhronizācija darbojas tikai saglabāšanas režīmā.",
        "data": {
          "recording_media_sync_enabled": "Ierakstīšanas multivides sinhronizācija",
          "recording_media_sync_hours": "Fona sinhronizācijas intervāls",
          "recording_media_storage_path": "Ierakstīšanas kešatmiņas mape",
          "recording_notification_quality": "Paziņojumu ierakstīšanas kvalitāte",
          "recording_media_days_order": "Ierakstīšanas dienas pasūtījums",
          "recording_media_clips_order": "Ierakstīšanas klipa pasūtījums",
          "recording_cache_retention_days": "Ieraksta kešatmiņas saglabāšana",
          "recording_cache_max_size_mb": "Maksimālais ierakstīšanas kešatmiņas lielums",
          "recording_cache_mode": "Ierakstu glabāšanas režīms"
        },
        "data_description": {
          "recording_media_sync_enabled": "Automātiski saglabājiet jaunākos ierakstus kešatmiņā. Tas izmanto krātuves vietu un var biežāk pamodināt kameras.",
          "recording_media_sync_hours": "Cik bieži vajadzētu darboties parastajai fona panākšanas sinhronizācijai. Kad sinhronizācija ir iespējota, pēdējie ieraksti tiek pārbaudīti ik pēc pāris minūtēm.",
          "recording_media_storage_path": "Izmantojiet mapi sadaļā /media. Šeit tiek glabāti jauni kešatmiņā saglabātie videoklipi un sīktēli.",
          "recording_notification_quality": "HD dod priekšroku augstākas izšķirtspējas ierakstu URL. SD dod priekšroku standarta izšķirtspējai, ja X-Sense to nodrošina.",
          "recording_media_days_order": "Izvēlieties, vai ierakstu skatītājā vispirms tiek rādītas jaunākas vai vecākas dienas.",
          "recording_media_clips_order": "Izvēlieties, vai katru dienu vispirms tiek rādīti jaunāki vai vecāki klipi.",
          "recording_cache_retention_days": "Pēc daudzām dienām izdzēsiet lokālos kešatmiņā saglabātos ierakstus. X-Sense mākoņa un SD kartes ieraksti netiek mainīti.",
          "recording_cache_max_size_mb": "Maksimālais vietējās kešatmiņas lielums MB. Kad limits ir sasniegts, vispirms tiek noņemti vismazāk skatītie ieraksti.",
          "recording_cache_mode": "Tikai atskaņošana pēc pieprasījuma pārsūta HLS multividi caur Home Assistant, nesaglabājot pilnus klipus. Saglabāšanas režīms glabā vietējās kopijas atbilstoši zemāk norādītajiem ierobežojumiem."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "Ierakstu kešatmiņas mape tiks mainīta no `{old_path}` uz `{new_path}`. Esošie kešatmiņā saglabātie videoklipi un sīktēli netiek automātiski pārvietoti. Ja vēlaties, lai vecie kešatmiņā saglabātie ieraksti būtu pieejami, vispirms pārvietojiet esošās mapes `hls`, `videos` un `thumbs`."
      }
    },
