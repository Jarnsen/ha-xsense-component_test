  "options": {
    "step": {
      "init": {
        "description": "סינכרון מדיה הקלטת מטמון קטעי מצלמה תחת המדיה של Home Assistant כך שסרגל הצד של הקלטות X-Sense, דפדפן המדיה והתראות לנייד יכולים לפתוח הקלטות במהירות. השאר את זה כדי לשמור הקלטות רק כשהן נפתחות. אפשר אותו כדי לשמור את ההקלטות האחרונות מוכנות ברקע.",
        "data": {
          "recording_media_sync_enabled": "סינכרון מדיה הקלטת",
          "recording_media_sync_hours": "מרווח סנכרון ברקע",
          "recording_media_storage_path": "תיקיית מטמון הקלטות",
          "recording_notification_quality": "איכות הקלטת הודעות",
          "recording_media_days_order": "סדר יום הקלטה",
          "recording_media_clips_order": "סדר הקלטת קליפים"
        },
        "data_description": {
          "recording_media_sync_enabled": "שמור הקלטות אחרונות באופן אוטומטי. זה משתמש בשטח אחסון ועלול להעיר מצלמות לעתים קרובות יותר.",
          "recording_media_sync_hours": "באיזו תדירות צריך לרוץ סנכרון התדמית הרגיל ברקע. הקלטות אחרונות נבדקות כל כמה דקות כאשר הסנכרון מופעל.",
          "recording_media_storage_path": "השתמש בתיקייה תחת /media. סרטונים ותמונות ממוזערות חדשות בקובץ שמור מאוחסנים כאן.",
          "recording_notification_quality": "בחר HD כדי להעדיף את כתובות ה-URL של קליפים ישירות/ברזולוציה גבוהה של X-Sense להתראות לנייד. בחר SD כדי להשתמש בנתיב לכידת השמעת המצלמה כאשר זמין.",
          "recording_media_days_order": "בחר אם ימים חדשים יותר או ישנים יותר יופיעו תחילה במציג ההקלטות.",
          "recording_media_clips_order": "בחר אם קליפים חדשים יותר או ישנים יותר יופיעו ראשונים בכל יום."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "תיקיית מטמון ההקלטה תשתנה מ-`{old_path}` ל-`{new_path}`. סרטונים ותמונות ממוזערות קיימים במטמון אינם מוזזים אוטומטית. העבר תחילה את התיקיות `videos` ו-`thumbs` הקיימות אם ברצונך שהקלטות ישנות המאוחסנות במטמון יישארו זמינות."
      }
    },
    "error": {
      "invalid_recording_media_path": "השתמש בתיקייה תחת /media."
    },
    "abort": {
      "no_options": "אין אפשרויות הניתנות להגדרה עבור חשבון X-Sense זה."
    }
  },
