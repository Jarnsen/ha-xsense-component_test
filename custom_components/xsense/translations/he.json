  "options": {
    "step": {
      "init": {
        "description": "מצב הפעלה בלבד הוא ברירת המחדל ומעביר הקלטות דרך Home Assistant בזמן הניגון בלי לשמור קליפים מלאים. בחר שמירת הקלטות מקומית כדי לשמור קליפים במדיה של Home Assistant לפי מגבלות הגיל והגודל שהוגדרו. סנכרון ברקע פועל רק במצב שמירה.",
        "data": {
          "recording_media_sync_enabled": "סינכרון מדיה הקלטת",
          "recording_media_sync_hours": "מרווח סנכרון ברקע",
          "recording_media_storage_path": "תיקיית מטמון הקלטות",
          "recording_notification_quality": "איכות הקלטת הודעות",
          "recording_media_days_order": "סדר יום הקלטה",
          "recording_media_clips_order": "סדר הקלטת קליפים",
          "recording_cache_retention_days": "שמירת מטמון הקלטה",
          "recording_cache_max_size_mb": "גודל מטמון הקלטה מקסימלי",
          "recording_cache_mode": "מצב אחסון הקלטות"
        },
        "data_description": {
          "recording_media_sync_enabled": "שמור הקלטות אחרונות באופן אוטומטי. זה משתמש בשטח אחסון ועלול להעיר מצלמות לעתים קרובות יותר.",
          "recording_media_sync_hours": "באיזו תדירות צריך לרוץ סנכרון התדמית הרגיל ברקע. הקלטות אחרונות נבדקות כל כמה דקות כאשר הסנכרון מופעל.",
          "recording_media_storage_path": "השתמש בתיקייה תחת /media. סרטונים ותמונות ממוזערות חדשות בקובץ שמור מאוחסנים כאן.",
          "recording_notification_quality": "HD מעדיף כתובות הקלטה ברזולוציה גבוהה יותר. SD מעדיף רזולוציה רגילה כאשר X-Sense מספק אותה.",
          "recording_media_days_order": "בחר אם ימים חדשים יותר או ישנים יותר יופיעו תחילה במציג ההקלטות.",
          "recording_media_clips_order": "בחר אם קליפים חדשים יותר או ישנים יותר יופיעו ראשונים בכל יום.",
          "recording_cache_retention_days": "מחק הקלטות מקומיות במטמון לאחר ימים רבים כל כך. הקלטות בענן X-Sense וכרטיס SD אינן משתנות.",
          "recording_cache_max_size_mb": "גודל מטמון מקומי מקסימלי ב-MB. כשמגיעים למגבלה, ההקלטות הפחות נצפו לאחרונה יוסרו תחילה.",
          "recording_cache_mode": "מצב הפעלה בלבד מעביר מדיית HLS דרך Home Assistant לפי דרישה בלי לשמור קליפים מלאים. מצב שמירה מחזיק עותקים מקומיים לפי המגבלות שלהלן."
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "תיקיית מטמון ההקלטה תשתנה מ-`{old_path}` ל-`{new_path}`. סרטונים ותמונות ממוזערות קיימים במטמון אינם מוזזים אוטומטית. העבר תחילה את התיקיות `hls`, `videos` ו-`thumbs` הקיימות אם ברצונך שהקלטות ישנות המאוחסנות במטמון יישארו זמינות."
      }
    },
