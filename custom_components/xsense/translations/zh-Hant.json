  "options": {
    "step": {
      "init": {
        "description": "預設使用僅播放模式，播放時透過 Home Assistant 代理錄影，不保留完整片段。選擇保留本機錄影，可依設定的保存期限和大小限制將片段存入 Home Assistant 媒體目錄。背景同步僅在保留模式下執行。",
        "data": {
          "recording_media_sync_enabled": "錄製媒體同步",
          "recording_media_sync_hours": "後台同步間隔",
          "recording_media_storage_path": "錄音快取資料夾",
          "recording_notification_quality": "通知錄製品質",
          "recording_media_days_order": "錄音日順序",
          "recording_media_clips_order": "錄製剪輯順序",
          "recording_cache_retention_days": "錄音快取保留",
          "recording_cache_max_size_mb": "最大錄音快取大小",
          "recording_cache_mode": "錄影儲存模式"
        },
        "data_description": {
          "recording_media_sync_enabled": "自動快取最近的錄製內容。這會佔用儲存空間，並且可能會更頻繁地喚醒攝影機。",
          "recording_media_sync_hours": "正常後台追趕同步應運轉的頻率。啟用同步後，每隔幾分鐘就會檢查最近的錄音。",
          "recording_media_storage_path": "使用 /media 下的資料夾。新的快取影片和縮圖會儲存在這裡。",
          "recording_notification_quality": "HD 優先使用較高解析度的錄影 URL。SD 優先使用 X-Sense 提供的標準解析度 URL（如有）。",
          "recording_media_days_order": "選擇較新的日期還是較舊的日期首先顯示在錄音檢視器中。",
          "recording_media_clips_order": "選擇每天首先顯示較新的剪輯還是較舊的剪輯。",
          "recording_cache_retention_days": "在這麼多天後刪除本地快取的錄音。 X-Sense雲端和SD卡錄音沒有改變。",
          "recording_cache_max_size_mb": "最大本地快取大小（以 MB 為單位）。當達到限制時，最近最少查看的錄音將首先被刪除。",
          "recording_cache_mode": "僅播放模式會依需求透過 Home Assistant 代理 HLS 媒體，不保留完整片段。保留模式會依下方限制保存本機副本。"
        }
      },
      "confirm_recording_media_storage_path": {
        "description": "錄製快取資料夾將從 `{old_path}` 變更為 `{new_path}`。現有的快取影片和縮圖不會自動移動。如果您希望舊的快取錄製內容仍然可用，請先移動現有的 `hls`, `videos` 和 `thumbs` 資料夾。"
      }
    },
    "error": {
      "invalid_recording_media_path": "請使用 /media 下的資料夾。"
    },
    "abort": {
      "no_options": "此 X-Sense 帳戶沒有可設定選項。"
    }
  },
